# Письма в стиле сайта (чёрный + #eaff00) — EmailJS
# 1) https://www.emailjs.com → Register
# 2) Add Email Service (Gmail / Outlook / свой SMTP на im@southwood.pw)
# 3) Create Email Template:
#    Subject: {{subject}}
#    Content (HTML): {{{html_body}}}
# 4) Account → API Keys → Public Key
# 5) Впиши значения ниже и в GitHub Secrets (Settings → Secrets → Actions)

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Запасной канал (без фирменного HTML) — Web3Forms
# https://web3forms.com → Access Key на im@southwood.pw
VITE_WEB3FORMS_ACCESS_KEY=
