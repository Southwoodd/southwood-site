---
import { content } from '../data/content.js';
import CaseLink from './CaseLink';
import Reveal from './Reveal.astro';
import './Cases.css';

const { num, h2, items } = content.cases;
---

<section class="section cases" id="cases" aria-labelledby="cases-title">
  <div class="container">
    <Reveal>
      <header class="cases__head">
        <p class="label cases__num">{num}</p>
        <h2 id="cases-title">{h2}</h2>
      </header>
    </Reveal>
  </div>

  <div class="cases__stack">
    {
      items.map((item) => (
        <Reveal>
          <CaseLink
            client:visible
            item={{
              title: item.title,
              tag: item.tag,
              result: item.result,
              href: item.href,
            }}
          />
        </Reveal>
      ))
    }
  </div>
</section>
