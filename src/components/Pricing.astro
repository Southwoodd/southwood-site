---
import { content } from '../data/content.js';
import OpenLeadCta from './OpenLeadCta';
import Reveal from './Reveal.astro';
import './Pricing.css';

const { num, h2, intro, items } = content.pricing;
---

<section class="section pricing" id="format" aria-labelledby="pricing-title">
  <div class="container">
    <Reveal>
      <header class="pricing__intro">
        <p class="label pricing__num">{num}</p>
        <h2 id="pricing-title">{h2}</h2>
        {intro ? <p class="pricing__lead">{intro}</p> : null}
      </header>
    </Reveal>

    <ul class="pricing__grid">
      {
        items.map((item, index) => (
          <Reveal as="li" className={`price-card${index === 0 ? ' price-card--entry' : ''}`}>
            <article class="price-card__inner">
              <div class="price-card__top">
                <p class="label price-card__badge">{item.badge}</p>
                <p class="label price-card__term">{item.term}</p>
              </div>

              <h3 class="price-card__title">{item.title}</h3>
              <p class="price-card__sum">{item.price}</p>
              <p class="price-card__text">{item.text}</p>

              <div class="price-card__points">
                <p class="label price-card__points-label">{item.pointsLabel}</p>
                <ul>
                  {item.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>

              <div class="price-card__cta">
                <OpenLeadCta
                  client:visible
                  className={`btn ${index === 0 ? 'btn--primary' : 'btn--ghost'} price-card__btn`}
                  label={item.cta}
                  topic={item.topic}
                  tariff={item.tariff}
                />
              </div>
            </article>
          </Reveal>
        ))
      }
    </ul>
  </div>
</section>
