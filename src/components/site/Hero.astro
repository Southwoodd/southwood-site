---
import Arrow from './Arrow.astro';
import Reel from './Reel.astro';
import { hero, nb } from '../../i18n/ru';
import { R_ } from '../../i18n/routes';
// Иконки фона: имя, x, y, ширина, высота в px макета 1920.
// Светлые webp нарисованы с запасом вокруг плашки, темные svg - плашка впритык,
// поэтому у темного набора своя геометрия: dx, dy, d - по месту и размеру плашки на светлом
const icons: [string, number, number, number, number, number, number, number][] = [
  ['bitrix', 10, -18, 220, 247, 82, -7, 138], ['pdf', 405, 55, 93, 93, 408, 58, 87],
  ['figma', 680, 129, 130, 143, 687, 138, 79], ['gpt', 857, -33, 145, 171, 897, -22, 97],
  ['brave', 1093, 94, 66, 88, 1105, 98, 39], ['tilda', 1409, 181, 132, 157, 1442, 189, 91],
  ['hf', 1715, 32, 263, 297, 1727, 45, 164], ['yandex', 35, 246, 122, 171, 61, 255, 63],
  ['opera', 532, 399, 170, 172, 541, 408, 101], ['docker', 297, 515, 243, 283, 317, 526, 189],
  ['chrome', 1216, 489, 149, 171, 1250, 497, 107], ['claude', 1556, 548, 192, 225, 1589, 560, 149],
];
---
<section class="section hero" id="hero">
  <div class="hero__icons" aria-hidden="true" data-drift>
    {icons.map(([n, x, y, w, h, dx, dy, d]) => (
      <>
        <img class="hero__ic--l" src={`/img/hero/ic/${n}.webp`} alt="" width={w} height={h} decoding="async" style={`left:${x / 10}rem;top:${y / 10}rem;width:${w / 10}rem`} />
        <img class="hero__ic--d" src={`/img/hero/ic-dark/${n}.svg`} alt="" width={d} height={d} decoding="async" style={`left:${dx / 10}rem;top:${dy / 10}rem;width:${d / 10}rem`} />
      </>
    ))}
  </div>
  <div class="hero__in">
    <span class="badge" data-reveal>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.4 2.1 3.2-.3.8 3.1 2.7 1.7-1.2 3 1.2 3-2.7 1.7-.8 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.8-3.1-2.7-1.7 1.2-3-1.2-3 2.7-1.7.8-3.1 3.2.3L12 2z" fill="#c5d9c8"/><path d="M8.5 12.2l2.3 2.3 4.7-4.8" stroke="#3f6b56" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {hero.badge}
    </span>
    <h1 class="hero__title" data-reveal style="--d:60ms">{nb(hero.title)}</h1>
    <div class="hero__sub" data-reveal style="--d:120ms">{hero.sub.map((s) => <p>{nb(s)}</p>)}</div>
    <div class="hero__cta" data-reveal style="--d:180ms">
      <a class="btn btn--deep hero__btn" href={R_.calc}>{hero.primary}<Arrow /></a>
      <button class="btn btn--grey hero__btn" type="button" data-open="lead">{hero.secondary}<Arrow /></button>
    </div>
    <p class="hero__proof" data-reveal style="--d:240ms">{nb(hero.proof)}</p>
  </div>
</section>
<div class="hero-reel"><Reel /></div>

<script>
  // Иконки фона неспешно дрейфуют в случайные стороны. Только десктоп, вне экрана стоят.
  const box = document.querySelector<HTMLElement>('[data-drift]');
  if (box && matchMedia('(min-width:1024px)').matches && !matchMedia('(prefers-reduced-motion:reduce)').matches) {
    const rnd = (a: number, b: number) => a + Math.random() * (b - a);
    let on = false;
    // Шаг назначаем по таймеру, а не по transitionend: скрытый темой набор иконок
    // события перехода не присылает и иначе застывал бы на месте до смены темы
    const step = (el: HTMLElement) => {
      clearTimeout(Number(el.dataset.t));
      if (!on) { el.dataset.wait = '1'; return; }
      const r = box.clientWidth / 186 * rnd(2.5, 6); // радиус в rem макета
      const a = rnd(0, Math.PI * 2);
      const s = rnd(7, 13);
      el.style.transition = `transform ${s.toFixed(1)}s ease-in-out`;
      el.style.transform = `translate(${(Math.cos(a) * r).toFixed(1)}px,${(Math.sin(a) * r).toFixed(1)}px) rotate(${rnd(-8, 8).toFixed(1)}deg)`;
      el.dataset.t = String(setTimeout(() => step(el), s * 1000 + 50));
    };
    const els = [...box.querySelectorAll<HTMLElement>('img')];
    els.forEach((el) => { el.dataset.wait = '1'; });
    new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      if (on) els.forEach((el) => { if (el.dataset.wait) { delete el.dataset.wait; setTimeout(() => step(el), rnd(0, 1200)); } });
    }).observe(box);
  }
</script>

<style>
  .hero{height:79.8rem;overflow:hidden}
  .hero__icons{position:absolute;inset:0;pointer-events:none}
  .hero__icons img{position:absolute;height:auto;max-width:none;mix-blend-mode:multiply;will-change:transform}
  /* У светлых иконок белая подложка без прозрачности, поэтому они сложены multiply.
     Темный набор - авторские SVG на зеленых плашках: показываем без смешивания,
     приглушенные до еле заметной фоновой текстуры */
  .hero__icons .hero__ic--d{display:none;mix-blend-mode:normal;opacity:.05}
  @media (prefers-color-scheme:dark){:root:not([data-theme=light]) .hero__icons .hero__ic--l{display:none}
    :root:not([data-theme=light]) .hero__icons .hero__ic--d{display:block}}
  :root[data-theme=dark] .hero__icons .hero__ic--l{display:none}
  :root[data-theme=dark] .hero__icons .hero__ic--d{display:block}
  .hero__in{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding-top:10rem}
  .hero__title{width:92rem;margin-top:5rem;font-size:6.9rem;line-height:7.2rem;font-weight:500;letter-spacing:-.03em;color:var(--ink-2);text-wrap:balance}
  .hero__sub{margin-top:2rem;color:var(--grey-text);font-size:max(1.8rem,15px);line-height:1.22}
  .hero__cta{display:flex;gap:1.2rem;margin-top:6rem}
  .hero__btn{height:9rem;padding:0 3rem;font-size:max(2.2rem,16px);border-radius:5rem;gap:3rem}
  .hero__btn :global(.arrow){width:2.4rem;height:2.4rem}
  .hero__proof{margin-top:2rem;color:var(--muted);font-size:max(1.6rem,13px)}
  /* Под заголовком идет живой шоурил: на широком экране горизонтальный, на телефоне в формате сторис */
  .hero-reel{position:relative;z-index:1;margin-top:-14.5rem}
  @media (max-width:1023px){.hero-reel{margin-top:0}}
  .mock{display:none!important}
  .mock{position:relative;z-index:1;height:68rem;margin-top:-14.5rem;border-radius:3.2rem;background:var(--deep);overflow:hidden}
  .mock__swirl{position:absolute;left:-4.1rem;top:-.2rem;width:194.7rem;height:71.4rem}
  .mock img{position:absolute;border-radius:2rem;height:auto}
  .mock__p1{left:4rem;top:5rem;width:44.1rem}
  .mock__p2{left:50.5rem;top:-32.2rem;width:44.1rem}
  .mock__d{left:74.8rem;top:18.6rem;width:118.4rem}
  @media (max-width:1023px){
    .hero{height:auto;padding:56px 20px 40px}
    .hero__icons{display:none}
    .hero__in{padding-top:0;gap:18px}
    .hero__title{width:auto;margin-top:0;font-size:38px;line-height:40px}
    .hero__sub{margin-top:0;font-size:16px;line-height:23px;display:flex;flex-direction:column;gap:14px;max-width:560px}
    .hero__sub p:nth-child(2){margin-top:-14px}
    .hero__cta{flex-direction:column;gap:8px;margin-top:0;width:100%;max-width:560px}
    .hero__btn{height:60px;font-size:17px;gap:10px;padding:0 20px}
    .hero__btn :global(.arrow){width:18px;height:18px}
    .hero__proof{margin-top:0;font-size:13px;line-height:18px;max-width:560px}
    .mock{height:300px;margin-top:0;border-radius:24px}
    .mock__swirl{left:-20px;top:0;width:760px;height:300px}
    .mock img{border-radius:8px}
    .mock__p1{left:14px;top:18px;width:159px}
    .mock__p2{left:182px;top:-76px;width:159px}
    .mock__d{left:269px;top:67px;width:426px}
  }
  @media (min-width:768px) and (max-width:1023px){.mock{height:340px}.mock__d{width:520px}}
</style>
