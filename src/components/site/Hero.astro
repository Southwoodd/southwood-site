---
import Arrow from './Arrow.astro';
import { hero, nb } from '../../i18n/ru';
---
<section class="section hero" id="top">
  <div class="hero__icons" aria-hidden="true"></div>
  <div class="hero__in">
    <span class="badge" data-reveal>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.4 2.1 3.2-.3.8 3.1 2.7 1.7-1.2 3 1.2 3-2.7 1.7-.8 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.8-3.1-2.7-1.7 1.2-3-1.2-3 2.7-1.7.8-3.1 3.2.3L12 2z" fill="#c5d9c8"/><path d="M8.5 12.2l2.3 2.3 4.7-4.8" stroke="#3f6b56" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="hero__badge-full">{hero.badge}</span><span class="hero__badge-short">{hero.badgeShort}</span>
    </span>
    <h1 class="hero__title" data-reveal style="--d:60ms">{nb(hero.title)}</h1>
    <div class="hero__sub" data-reveal style="--d:120ms">{hero.sub.map((s) => <p>{nb(s)}</p>)}</div>
    <div class="hero__cta" data-reveal style="--d:180ms">
      <a class="btn btn--deep hero__btn" href="#pricing">{hero.primary}<Arrow /></a>
      <button class="btn btn--grey hero__btn" type="button" data-open="lead">{hero.secondary}<Arrow /></button>
    </div>
    <p class="hero__proof" data-reveal style="--d:240ms">{nb(hero.proof)}</p>
  </div>
</section>
<div class="mock" aria-hidden="true" data-reveal>
  <svg class="mock__swirl" viewBox="0 0 1987 754" fill="none" preserveAspectRatio="none"><path opacity=".5" d="M20.4 712.9C9.2 615.6 220.6-7.1 529.9 20.9c386.7 35.1 515.4 523.1 363 653-152.4 130-351.2 20.1-384-59C328.9 180.3 1176.8 108.5 1176.8 108.5c354.6-28.1 698.6 114.7 790.6 129.9" stroke="#D5E0D8" stroke-width="40" stroke-linecap="round"/></svg>
  <img class="mock__p1" src="/img/hero/phone-a.webp" width="417" height="873" alt="" loading="eager" />
  <img class="mock__p2" src="/img/hero/phone-b.webp" width="425" height="872" alt="" loading="eager" />
  <img class="mock__d" src="/img/hero/desktop.webp" srcset="/img/hero/desktop-900.webp 900w, /img/hero/desktop.webp 1885w" sizes="(max-width:1023px) 70vw, 62vw" width="1885" height="1278" alt="" loading="eager" />
</div>

<style>
  .hero{height:79.8rem;overflow:hidden}
  .hero__icons{position:absolute;left:5rem;top:-5.7rem;width:185rem;height:79.8rem;background:url('/img/hero/icons.webp') center/100% 100% no-repeat;pointer-events:none}
  .hero__in{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding-top:10rem}
  .hero__badge-short{display:none}
  .hero__title{width:92rem;margin-top:5rem;font-size:6.9rem;line-height:7.2rem;font-weight:500;letter-spacing:-.03em;color:var(--ink-2);text-wrap:balance}
  .hero__sub{margin-top:2rem;color:var(--grey-text);font-size:max(1.8rem,15px);line-height:1.22}
  .hero__cta{display:flex;gap:1.2rem;margin-top:6rem}
  .hero__btn{height:9rem;padding:0 3rem;font-size:max(2.2rem,16px);border-radius:5rem;gap:3rem}
  .hero__btn :global(.arrow){width:2.4rem;height:2.4rem}
  .hero__proof{margin-top:2rem;color:var(--muted);font-size:max(1.6rem,13px)}
  .mock{position:relative;z-index:1;height:68rem;margin-top:-14.5rem;border-radius:3.2rem;background:var(--deep);overflow:hidden}
  .mock__swirl{position:absolute;left:-4.1rem;top:-.2rem;width:194.7rem;height:71.4rem}
  .mock img{position:absolute;border-radius:2rem;height:auto}
  .mock__p1{left:4rem;top:5rem;width:44.1rem}
  .mock__p2{left:50.5rem;top:-32.2rem;width:44.1rem}
  .mock__d{left:74.8rem;top:18.6rem;width:118.4rem}
  @media (max-width:1023px){
    .hero{height:auto;padding:56px 20px 40px}
    .hero__icons{display:none}
    .hero__in{padding-top:0;gap:18px}
    .hero__badge-full{display:none}.hero__badge-short{display:inline}
    .hero__title{width:auto;margin-top:0;font-size:38px;line-height:40px}
    .hero__sub{margin-top:0;font-size:16px;line-height:23px;display:flex;flex-direction:column;gap:14px;max-width:560px}
    .hero__sub p:nth-child(2){margin-top:-14px}
    .hero__cta{flex-direction:column;gap:8px;margin-top:0;width:100%;max-width:560px}
    .hero__btn{height:60px;font-size:17px;gap:10px;padding:0 20px}
    .hero__btn :global(.arrow){width:18px;height:18px}
    .hero__proof{margin-top:0;font-size:13px;line-height:18px;max-width:560px}
    .mock{height:300px;margin-top:0;border-radius:24px}
    .mock__swirl{left:-20px;top:0;width:760px;height:300px}
    .mock img{border-radius:8px}
    .mock__p1{left:14px;top:18px;width:159px}
    .mock__p2{left:182px;top:-76px;width:159px}
    .mock__d{left:269px;top:67px;width:426px}
  }
  @media (min-width:768px) and (max-width:1023px){.mock{height:340px}.mock__d{width:520px}}
</style>
