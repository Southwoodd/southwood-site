---
import Logo from '../Logo.astro';
import Arrow from './Arrow.astro';
import MenuIcon from './MenuIcon.astro';
import { nav as navAll, navBlog, header, site, nb } from '../../i18n/ru';
import { R_ } from '../../i18n/routes';
import { BLOG_LIVE } from '../../i18n/blog';
// Шапка работает на телефоне и планшете. На десктопе ее заменяет нижняя плашка Dock.
const nav = navAll.map((n: any) => (n.swap && BLOG_LIVE ? navBlog : n)) as any[];
const path = Astro.url.pathname;
const cur = (href: string) => (!href.includes('#') && path.startsWith(href) ? 'page' : undefined);
---
<header class="hdr" data-header>
  <a class="hdr__brand" href="/" aria-label={site.name}>
    <Logo size={32} /><span>{site.name}</span>
  </a>
  <div class="hdr__right">
    <button class="btn btn--deep hdr__cta" type="button" data-open="write"><span class="hdr__cta-full">{header.cta}</span><span class="hdr__cta-short">{header.ctaShort}</span><Arrow /></button>
    <button class="hdr__burger" type="button" aria-label="Меню" aria-expanded="false" aria-controls="menu" data-menu-open><i></i><i></i></button>
  </div>
</header>

<div class="menu" id="menu" hidden>
  <nav class="menu__grid" aria-label="Разделы">
    {nav.map((n) => (
      <a class:list={['tile', { 'tile--accent': n.accent, 'is-active': cur(n.href) }]} style={`--i:${nav.indexOf(n)}`} href={n.href} aria-current={cur(n.href)} data-menu-link>
        <span class="tile__top"><i class="tile__dot"><MenuIcon n={n.icon} /></i><Arrow /></span>
        <span class="tile__text"><b>{n.label}</b><small>{nb(n.hint)}</small></span>
      </a>
    ))}
  </nav>
  <a class:list={['menu__qatar', { 'is-active': cur(R_.qatar) }]} href={R_.qatar} data-menu-link><span><b>{header.qatarShort}</b><small>{header.qatarHint}</small></span><Arrow /></a>
  <div class="menu__contact">
    <div><b>{header.menuTitle}</b><small>{nb(header.menuSub)}</small></div>
    <button class="btn btn--white menu__write" type="button" data-open="write" data-menu-link>{header.cta}<Arrow /></button>
    <div class="menu__links"><a href={site.telegram} target="_blank" rel="noopener">Telegram</a><a href={`mailto:${site.email}`}>Почта</a><button class="menu__snd" type="button" data-snd-toggle aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3l5-4v13l-5-4H4z"/><path class="snd-on" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/><path class="snd-off" d="m16 9.5 5 5m0-5-5 5"/></svg>Звуки сайта <span data-snd-label>включены</span></button></div>
  </div>
</div>

<script>
  const menu = document.getElementById('menu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const hdr = document.querySelector<HTMLElement>('[data-header]')!;
  const set = (open: boolean) => {
    if (open) {
      const r = hdr.getBoundingClientRect();
      menu.style.setProperty('--mt', `${Math.round(r.bottom + 8)}px`);
      menu.style.setProperty('--ms', `${Math.round(r.left)}px`);
      menu.scrollTop = 0;
    }
    openBtn.setAttribute('aria-expanded', String(open));
    openBtn.setAttribute('aria-label', open ? 'Закрыть меню' : 'Меню');
    clearTimeout(closing); menu.classList.remove('is-closing');
    // Открытие: меню выезжает сверху, плитки подтягиваются следом. Закрытие: уезжает обратно и только потом прячется
    const done = () => { menu.hidden = !open; hdr.classList.toggle('is-open', open); document.documentElement.style.overflow = open ? 'hidden' : ''; menu.classList.remove('is-closing'); };
    if (open || menu.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) return done();
    menu.classList.add('is-closing'); closing = window.setTimeout(done, 240);
  };
  let closing = 0;
  openBtn.addEventListener('click', () => set(menu.hidden || menu.classList.contains('is-closing')));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) set(false); });
  const onScroll = () => hdr.classList.toggle('is-stuck', scrollY > 24);
  matchMedia('(min-width:1024px)').addEventListener('change', (e) => { if (e.matches && !menu.hidden) set(false); });
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>

<style>
  .hdr{position:sticky;top:3rem;z-index:50;height:10rem;background:#fff;border-radius:2.8rem;display:flex;align-items:center;padding:0 4rem;gap:3rem;transition:box-shadow .3s var(--ease),height .3s var(--ease)}
  .hdr.is-stuck{box-shadow:0 1rem 4rem rgba(20,32,26,.1);height:8rem}
  .hdr__brand{display:flex;align-items:center;gap:1.2rem;color:var(--deep);font-size:2.4rem;font-weight:500;white-space:nowrap;--logo-dot:var(--accent)}
  .hdr__brand :global(svg){width:3.2rem;height:3.2rem}
  .hdr__right{display:flex;align-items:center;gap:1.6rem}
  .lang{display:flex;gap:.2rem;padding:.4rem;border-radius:999px;background:var(--card);font-size:max(1.4rem,12px);font-weight:500;color:var(--muted)}
  .lang>*{padding:.8rem 1.2rem;border-radius:999px;line-height:1.3}
  .lang__on{background:var(--ink);color:#fff}
  .lang a:hover{color:var(--ink)}
  .hdr__cta{height:5.6rem;padding:0 2.4rem;font-size:max(1.6rem,14px)}
  .hdr__cta-short,.hdr__burger{display:none}
  .menu{display:none}
  @media (min-width:1024px){.hdr{display:none}}
  @media (max-width:1023px){
    .hdr{top:8px;height:60px;border-radius:22px;padding:0 8px 0 16px;gap:8px}
    .hdr.is-stuck{height:60px;box-shadow:0 8px 24px rgba(20,32,26,.1)}
    .hdr__brand{font-size:16px;gap:10px}.hdr__brand :global(svg){width:26px;height:26px}
    .hdr__right .lang,.hdr__cta-full,.hdr__cta :global(.arrow){display:none}
    .hdr__right{margin-left:auto;gap:6px}
    .hdr__cta{height:44px;padding:0 16px;font-size:14px}.hdr__cta-short{display:inline}
    .hdr__burger{display:grid;place-items:center;flex:none;width:44px;height:44px;border-radius:999px;background:var(--ink)}
    .hdr__burger i{grid-area:1/1;width:18px;height:2px;border-radius:1px;background:#fff;transition:transform .35s var(--ease)}
    .hdr__burger i:first-child{transform:translateY(-3.5px)}
    .hdr__burger i:last-child{transform:translateY(3.5px)}
    .hdr__burger[aria-expanded=true] i:first-child{transform:rotate(45deg)}
    .hdr__burger[aria-expanded=true] i:last-child{transform:rotate(-45deg)}
    .hdr.is-open{z-index:110;box-shadow:none}
    .hdr.is-open .hdr__cta{visibility:hidden}
    .menu{position:fixed;inset:0;z-index:100;background:var(--bg);padding:var(--mt,76px) var(--ms,8px) 12px;display:flex;flex-direction:column;gap:8px;overflow-y:auto;animation:menuIn .46s cubic-bezier(.2,.8,.2,1) both}
    .menu>*{animation:menuItem .5s cubic-bezier(.2,.8,.2,1) both;animation-delay:.14s}
    .menu__grid{animation:none}
    .menu__grid>*{animation:menuItem .5s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(.05s + var(--i,0)*.035s)}
    .menu__qatar{animation-delay:.3s}.menu__contact{animation-delay:.36s}
    .menu.is-closing{animation:menuOut .24s cubic-bezier(.5,0,.8,.3) both}
    .menu.is-closing>*,.menu.is-closing .menu__grid>*{animation:none}
    @media (prefers-reduced-motion:reduce){.menu,.menu>*,.menu__grid>*{animation:none}}
    .menu[hidden]{display:none}
    .menu::before{content:'';position:fixed;z-index:1;left:0;right:0;top:0;height:var(--mt,76px);background:var(--bg)}
    .menu__grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .tile{background:#fff;border-radius:22px;padding:14px;min-height:124px;display:flex;flex-direction:column;justify-content:space-between;color:var(--ink)}
    .tile__top{display:flex;justify-content:space-between;align-items:flex-start}
    .tile__top :global(.arrow){width:16px;height:16px}
    .tile__dot{width:38px;height:38px;border-radius:999px;background:var(--mint);color:var(--deep);display:grid;place-items:center}
    .tile__dot :global(svg){width:20px;height:20px}
    .tile__text{display:flex;flex-direction:column;gap:2px}
    .tile b{font-size:22px;line-height:26px;font-weight:500}
    .tile small{font-size:13px;line-height:17px;color:var(--muted)}
    .tile.is-active{box-shadow:inset 0 0 0 2px var(--deep)}.tile--accent.is-active{box-shadow:inset 0 0 0 2px var(--light)}.menu__qatar.is-active{box-shadow:inset 0 0 0 2px rgba(255,255,255,.6)}
    .tile--accent{background:var(--deep);color:#fff}.tile--accent small{color:rgba(255,255,255,.75)}.tile--accent .tile__dot{background:rgba(255,255,255,.16);color:#fff}
    .menu__qatar{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--qatar);color:#fff;border-radius:22px;padding:14px 14px 14px 16px}
    .menu__qatar span{display:flex;flex-direction:column;gap:2px}
    .menu__qatar b{font-size:17px;line-height:22px;font-weight:500}.menu__qatar small{font-size:13px;line-height:17px;opacity:.7}
    .menu__qatar :global(.arrow){width:16px;height:16px}
    .menu__contact{margin-top:auto;background:var(--ink);color:#fff;border-radius:26px;padding:18px 14px 14px;display:flex;flex-direction:column;gap:12px}
    .menu__contact>div:first-child{display:flex;flex-direction:column;gap:2px;padding-left:4px}
    .menu__contact b{font-size:20px;line-height:24px;font-weight:500}.menu__contact small{font-size:13px;opacity:.6}
    .menu__write{height:54px;font-size:16px;width:100%}
    .menu__links{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .menu__snd{grid-column:1/-1;height:46px;border-radius:999px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;gap:8px;font-size:15px;font-weight:500}
    .menu__snd svg{width:20px;height:20px}
    .menu__links a{height:46px;border-radius:999px;background:rgba(255,255,255,.1);display:grid;place-items:center;font-size:15px;font-weight:500}
  }
  @media (max-height:700px) and (max-width:1023px){.tile{min-height:100px}}
  @keyframes menuIn{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0 0 0 0)}}
  @keyframes menuOut{from{clip-path:inset(0 0 0 0)}to{clip-path:inset(0 0 100% 0)}}
  @keyframes menuItem{from{opacity:0;transform:translateY(-18px)}to{opacity:1;transform:none}}
</style>
