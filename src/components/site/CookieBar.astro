---
// Уведомление о cookies. Метрика подключается только после согласия на аналитику.
import { cookies as c, METRIKA_ID } from '../../i18n/ru';
---
<div class="ck" id="cookie-bar" role="dialog" aria-label="Cookies" hidden>
  <p>{c.text}</p>
  <a href="/privacy/#cookies">{c.more}</a>
  <div><button class="btn btn--white" type="button" data-cookie="all">{c.all}</button><button class="btn ck__ghost" type="button" data-cookie="tech">{c.tech}</button></div>
</div>
<script is:inline define:vars={{ METRIKA_ID }}>
  (function () {
    var KEY = 'sw-cookies', YEAR = 365 * 864e5, bar = document.getElementById('cookie-bar');
    function read() { try { var v = JSON.parse(localStorage.getItem(KEY) || 'null'); return v && Date.now() - v.t < YEAR ? v.c : null; } catch (e) { return null; } }
    function metrika() {
      if (window.ym) return;
      (function (m, e, t, r, i, k, a) { m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); }; m[i].l = 1 * new Date(); k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a); })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
      window.ym(METRIKA_ID, 'init', { webvisor: true, clickmap: true, referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
    }
    // Цели: пока согласия нет, вызовы просто пропускаются
    window.swGoal = function (name, params) { if (window.ym) window.ym(METRIKA_ID, 'reachGoal', name, params); };
    window.swCookies = function () { bar.hidden = false; };
    var choice = read();
    if (choice === 'all') metrika(); else if (!choice) bar.hidden = false;
    bar.addEventListener('click', function (e) {
      var b = e.target.closest('[data-cookie]'); if (!b) return;
      try { localStorage.setItem(KEY, JSON.stringify({ c: b.dataset.cookie, t: Date.now() })); } catch (err) {}
      if (b.dataset.cookie === 'all') metrika();
      bar.hidden = true;
    });
    document.addEventListener('click', function (e) { if (e.target.closest('[data-cookie-settings]')) { e.preventDefault(); bar.hidden = false; } });
  })();
</script>
<style>
  /* Темная плашка поверх страницы: на светлом сайте ее видно сразу,
     и она не спорит с кнопками и итогом калькулятора под ней */
  .ck{position:fixed;left:3rem;bottom:3rem;z-index:80;width:fit-content;max-width:calc(100vw - 6rem);background:var(--ink);color:#fff;border-radius:2.4rem;padding:2.4rem;box-shadow:0 2rem 6rem rgba(10,30,20,.28);display:grid;gap:.8rem;animation:ck-in .5s var(--ease) both}
  .ck[hidden]{display:none}
  @keyframes ck-in{from{opacity:0;transform:translateY(2rem)}}
  /* Ширину карточки задает описание. Меряем перенос в ch, а не в rem: размер
     шрифта упирается в 14px, и в rem текст на узком десктопе ломался на три
     строки и вылезал из кнопок. В ch перенос идет за шрифтом - всегда две строки */
  .ck p{max-width:35ch;font-size:max(1.5rem,14px);line-height:1.45}
  .ck>a{justify-self:start;font-size:max(1.4rem,13px);color:#fff;text-decoration:underline;text-underline-offset:.3rem}
  .ck>a:hover{color:var(--light)}
  /* Кнопки отбиваем от текста сильнее, чем ссылку от абзаца */
  .ck div{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:.8rem}
  /* Кнопки по ширине подписи, как в макете: тянуть их до края нельзя - шрифт
     упирается в 14px, а коробка в rem, и подпись вылезала за кнопку */
  .ck .btn{flex:none;height:4.8rem;padding:0 2.2rem;font-size:max(1.5rem,14px)}
  /* Второй вариант выбора: обводкой, чтобы не спорил с «Принять все» */
  .ck__ghost{background:transparent;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.35)}
  .ck__ghost:hover{background:rgba(255,255,255,.1)}
  /* На телефоне плашка прижата к нижнему краю на всю ширину, кнопки в столбик:
     в строку они помещались впритык и на узких экранах переносились разной ширины */
  @media (max-width:1023px){
    .ck{left:8px;right:8px;bottom:8px;width:auto;max-width:none;border-radius:20px;padding:16px;gap:6px}
    .ck p{max-width:none}
    .ck div{flex-direction:column;margin-top:6px}
    .ck .btn{flex:none;width:100%;height:46px;padding:0 22px}
  }
  @media (prefers-reduced-motion:reduce){.ck{animation:none}}
</style>