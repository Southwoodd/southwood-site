---
import { faq as f, nb } from '../../i18n/ru';
import Badge from '../ui/Badge.astro';
import Arrow from './Arrow.astro';
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: f.list.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) };
---
<section class="section fq" id="faq">
  <div class="head head--center fq__head">
    <Badge icon="task" reveal>{f.badge}</Badge>
    <h2 class="head__title" data-reveal style="--d:60ms">{f.title}</h2>
    <p class="head__intro" data-reveal style="--d:120ms">{nb(f.intro)}</p>
  </div>
  <div class="fq__grid">
    <aside class="fq__ask" data-reveal>
      <span class="fq__ico"><svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M19.8 4.7H8.2C5.6 4.7 3.5 6.800 3.500 9.300v7c0 2.600 2.100 4.600 4.700 4.600h1.200v2.300c0 .9 1 1.400 1.700.9l4.300-3.200h4.400c2.600 0 4.700-2 4.700-4.600v-7c0-2.500-2.100-4.600-4.700-4.600z" fill="#fff"/><path d="M11.600 10.600c0-1.300 1.100-2.300 2.400-2.300s2.400 1 2.400 2.300c0 1.600-2.400 1.800-2.400 3.500M14 16.900v.1" stroke="#3f6b56" stroke-width="1.700" stroke-linecap="round"/></svg></span>
      <h3>{f.ask.title}</h3>
      <p>{nb(f.ask.text)}</p>
      <a class="btn btn--white fq__btn" href={f.ask.href} target="_blank" rel="noopener">{f.ask.btn}<Arrow /></a>
      <a class="fq__handle" href={f.ask.href} target="_blank" rel="noopener">{f.ask.handle}</a>
    </aside>
    <div class="fq__list">
      {f.list.map((x, i) => (
        <details name="faq" open={i === 0} data-reveal style={`--d:${Math.min(i, 5) * 50}ms`}>
          <summary><h3>{nb(x.q)}</h3><i></i></summary>
          <p>{nb(x.a)}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
<style>
  .fq{background:var(--mint);padding:10rem 4rem 3.5rem}
  .fq__head .head__title{margin-top:2.8rem}
  .fq__head .head__intro{margin-top:2rem;max-width:76rem;font-size:max(2rem,15px);line-height:1.4;color:var(--muted)}
  .fq__grid{margin-top:7.2rem;display:grid;grid-template-columns:52rem 1fr;gap:2rem;align-items:start}
  .fq__ask{position:sticky;top:14rem;background:var(--deep);color:#fff;border-radius:2.4rem;padding:3.6rem;display:flex;flex-direction:column;align-items:flex-start}
  .fq__ico{width:5.6rem;height:5.6rem;border-radius:50%;background:rgba(255,255,255,.14);display:grid;place-items:center}
  .fq__ico svg{width:2.8rem;height:2.8rem}
  .fq__ask h3{margin-top:2rem;font-size:3.6rem;line-height:4.2rem;font-weight:500;letter-spacing:-.03em}
  .fq__ask p{margin-top:2rem;font-size:max(1.8rem,14px);line-height:1.45;color:rgba(255,255,255,.8)}
  .fq__btn{margin-top:2rem;height:5.8rem;padding:0 2.2rem 0 2.8rem;font-size:max(1.7rem,15px)}
  .fq__handle{margin-top:2rem;font-size:max(1.6rem,13px);font-weight:500;color:var(--light)}
  .fq__handle:hover{text-decoration:underline;text-underline-offset:.4rem}
  .fq__list{display:grid;gap:1rem}
  .fq details{background:#fff;border-radius:2rem;padding:2.4rem 2.6rem;transition:box-shadow .3s var(--ease)}
  .fq details:hover{box-shadow:0 1rem 3rem rgba(10,30,20,.06)}
  .fq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:flex-start;gap:1.6rem}
  .fq summary::-webkit-details-marker{display:none}
  .fq summary h3{font-size:max(2rem,16px);line-height:1.3;font-weight:500;letter-spacing:-.02em}
  .fq summary i{flex:none;position:relative;width:2.8rem;height:2.8rem;border-radius:50%;background:var(--ink);transition:background-color .25s var(--ease),transform .35s var(--ease)}
  .fq summary i::before,.fq summary i::after{content:'';position:absolute;left:28%;right:28%;top:calc(50% - 1px);height:2px;border-radius:1px;background:#fff}
  .fq summary i::after{transform:rotate(90deg);transition:opacity .2s}
  .fq details[open] summary i{background:var(--deep);transform:rotate(180deg)}
  .fq details[open] summary i::after{opacity:0}
  .fq details p{margin-top:1.2rem;font-size:max(1.7rem,14px);line-height:1.47}
  @supports (interpolate-size:allow-keywords){
    .fq details{interpolate-size:allow-keywords}
    .fq details::details-content{height:0;overflow:clip;transition:height .4s var(--ease),content-visibility .4s allow-discrete}
    .fq details[open]::details-content{height:auto}
  }
  @media (max-width:1023px){
    .fq{padding:56px 12px 12px}
    .fq__head{padding:0 8px 8px;align-items:center}
    .fq__head .head__title,.fq__head .head__intro{margin-top:0}
    .fq__head .head__intro{font-size:15px;line-height:21px}
    .fq__grid{margin-top:20px;display:flex;flex-direction:column-reverse;gap:12px;align-items:stretch}
    .fq__ask{position:static;border-radius:20px;padding:20px}
    .fq__ask h3{margin-top:16px;font-size:24px;line-height:30px}
    .fq__ask p{margin-top:12px;font-size:15px;line-height:21px}
    .fq__btn{margin-top:16px;width:100%;height:56px;font-size:16px}
    .fq__handle{margin-top:16px;font-size:16px}
    .fq__list{gap:12px}
    .fq details{border-radius:16px;padding:16px}
    .fq summary h3{font-size:17px;line-height:22px}
    .fq summary i{width:20px;height:20px;margin-top:2px}
    .fq details p{margin-top:10px;font-size:14px;line-height:20px}
  }
  @media (min-width:768px) and (max-width:1023px){.fq{padding:56px 20px 20px}}
</style>
