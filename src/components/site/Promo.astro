---
// Плашка акции над первым экраном главной. После даты окончания не собирается и сама убирается у тех, у кого страница в кеше.
import Arrow from './Arrow.astro';
import { site } from '../../i18n/ru';
const promo = { until: '2026-11-01T00:00:00+03:00', label: 'До 31 октября', text: 'скидка 10% на новый проект', hint: 'Напишите мне промокод', code: 'ОКТЯБРЬ10' };
const live = Date.now() < Date.parse(promo.until);
const tg = `${site.telegram}?text=${encodeURIComponent(`Здравствуйте! Промокод ${promo.code}`)}`;
---
{live && (
  <aside class="section pm" data-promo data-until={promo.until} aria-label="Акция">
    <span class="pm__bg" aria-hidden="true"><i class="pm__glow"></i><i class="pm__sheen"></i></span>
    <p class="pm__main"><span class="pm__tag">{promo.label}</span><b>{promo.text}</b></p>
    <p class="pm__how"><span>{promo.hint}</span><button type="button" class="pm__code" data-goal="promo_copy" data-copy={promo.code} aria-label={`Скопировать промокод ${promo.code}`}><span data-code>{promo.code}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8.500" y="8.500" width="11" height="11" rx="2.500"/><path d="M15.500 5.500v-.5a2 2 0 0 0-2-2H6.500a2.500 2.500 0 0 0-2.500 2.500V13a2 2 0 0 0 2 2h.5"/></svg></button></p>
    <a class="btn btn--white pm__btn" data-goal="promo_telegram" href={tg} target="_blank" rel="noopener">Написать в Telegram<Arrow /></a>
  </aside>
  <script is:inline>
    (function () {
      var el = document.querySelector('[data-promo]'); if (!el) return;
      if (Date.now() >= Date.parse(el.dataset.until)) { el.remove(); return; }
      // Подсветка под курсором
      (function () {
        if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        var on = false, raf = 0, amp = 0, mx = .5, my = .5, cx = .5, cy = .5;
        function frame() {
          amp += ((on ? 1 : 0) - amp) * .09; cx += (mx - cx) * .14; cy += (my - cy) * .14;
          el.style.setProperty('--mx', (cx * 100).toFixed(1) + '%'); el.style.setProperty('--my', (cy * 100).toFixed(1) + '%');
          el.style.setProperty('--amp', amp.toFixed(3));
          raf = (on || amp > .004) ? requestAnimationFrame(frame) : 0;
        }
        el.addEventListener('pointerenter', function () { on = true; if (!raf) raf = requestAnimationFrame(frame); });
        el.addEventListener('pointermove', function (e) { var r = el.getBoundingClientRect(); mx = (e.clientX - r.left) / r.width; my = (e.clientY - r.top) / r.height; });
        el.addEventListener('pointerleave', function () { on = false; });
      })();
      var b = el.querySelector('[data-copy]'), t = el.querySelector('[data-code]'), code = b.dataset.copy;
      b.addEventListener('click', function () {
        (navigator.clipboard ? navigator.clipboard.writeText(code) : Promise.reject()).then(function () { t.textContent = 'Скопировано'; setTimeout(function () { t.textContent = code; }, 1600); }).catch(function () {});
      });
    })();
  </script>
)}
<style>
  .pm{background:transparent!important;isolation:isolate;--mx:50%;--my:50%;--amp:0}
  .pm>:not(.pm__bg){position:relative;z-index:1}
  .pm__bg{position:absolute;inset:0;z-index:0;border-radius:inherit;background:var(--deep);overflow:hidden}
  .pm__glow{position:absolute;inset:-40% -5%;background:radial-gradient(28rem 16rem at var(--mx) var(--my),rgba(190,224,204,.55),rgba(125,171,144,.25) 45%,transparent 70%);opacity:var(--amp);mix-blend-mode:screen}
  .pm__sheen{position:absolute;top:0;bottom:0;left:-30%;width:26%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.16) 45%,rgba(255,255,255,.28) 50%,rgba(255,255,255,.16) 55%,transparent);transform:skewX(-18deg);animation:pm-sheen 7s cubic-bezier(.4,0,.2,1) 1.5s infinite}
  @keyframes pm-sheen{0%{left:-30%}38%,100%{left:120%}}
  @media (prefers-reduced-motion:reduce){.pm__sheen{animation:none;display:none}}
  .pm{color:#fff;min-height:8rem;padding:1.2rem 1.2rem 1.2rem 3.2rem;display:flex;align-items:center;gap:2.4rem}
  .pm__main{display:flex;align-items:center;gap:1.6rem;font-size:max(2.2rem,16px);letter-spacing:-.02em}
  .pm__tag{height:3.6rem;padding:0 1.4rem;border-radius:999px;background:var(--light);color:var(--ink);display:inline-flex;align-items:center;font-size:max(1.5rem,13px);font-weight:500;white-space:nowrap}
  .pm__main b{font-weight:500}
  .pm__how{margin-left:auto;display:flex;align-items:center;gap:1.2rem;font-size:max(1.6rem,14px);color:rgba(255,255,255,.8)}
  .pm__code{height:4.4rem;padding:0 1.4rem 0 1.8rem;border-radius:999px;border:1px dashed rgba(255,255,255,.55);color:#fff;display:inline-flex;align-items:center;gap:1rem;font-size:max(1.7rem,14px);font-weight:500;letter-spacing:.04em;transition:background-color .2s var(--ease)}
  .pm__code:hover{background:rgba(255,255,255,.12)}
  .pm__code svg{width:1.8rem;height:1.8rem;opacity:.8}
  .pm__btn{height:5.6rem;padding:0 2.4rem;font-size:max(1.6rem,14px);flex:none}
  /* телефон: вместо rem берем нижнюю границу в px */
  @media (max-width:1023px){.pm__main{font-size:16px}.pm__tag{font-size:13px}.pm__how{font-size:14px}.pm__code{font-size:14px}.pm__btn{font-size:14px}}
  @media (max-width:1023px){
    .pm{flex-wrap:wrap;gap:10px 12px;padding:14px;min-height:0}
    .pm__main{flex-wrap:wrap;gap:8px;font-size:17px;width:100%}
    .pm__tag{height:28px;padding:0 10px;font-size:13px}
    .pm__how{margin-left:0;gap:8px;font-size:14px;flex-wrap:wrap}
    .pm__code{height:38px;padding:0 10px 0 14px;font-size:14px}.pm__code svg{width:16px;height:16px}
    .pm__btn{height:48px;width:100%;font-size:15px}
  }
</style>
