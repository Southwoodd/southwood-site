---
import '../../styles/pricing.css';
import { pricing as p, nb } from '../../i18n/ru';
import { R_ } from '../../i18n/routes';
import Head from '../ui/Head.astro';
import Ui from '../ui/Ui.astro';
import Arrow from './Arrow.astro';
import Calc from '../../pricing/Pricing.tsx';
---
<section class="section pz" id="pricing">
  <div class="pz__head"><Head badge={p.badge} icon="task" intro={p.intro} title={p.title} /></div>
  <Calc client:visible={{ rootMargin: '600px' }} />
  <div class="pz__inst" data-reveal>
    <div>
      <h3>{p.inst.title}</h3>
      <p class="pz__inst-text">{p.inst.text.map((l) => <span>{nb(l)} </span>)}</p>
      <p class="pz__inst-note">{nb(p.inst.note)}</p>
      <a class="btn btn--white pz__inst-btn" href="#pricing" data-go="inst">{p.inst.btn}<Arrow /></a>
    </div>
    <ul>{p.inst.facts.map((f) => <li><b>{f[0]}</b><span>{f[1]}</span></li>)}</ul>
  </div>
  <ul class="pz__guar">{p.guarantees.map((g, i) => <li data-reveal style={`--d:${i * 80}ms`}><span><Ui n={g.icon as any} /></span><div><b>{g.title}</b><p>{nb(g.text)}</p></div></li>)}</ul>
  <div class="pz__faq">
    <div><h3>{p.faqTitle}</h3><p>{nb(p.faqSub)}</p></div>
    <div class="pz__list">{p.faq.map((x, i) => <details name="price-faq" open={i === 0} data-reveal><summary><h4>{nb(x.q)}</h4><i></i></summary><p>{nb(x.a)}</p></details>)}</div>
  </div>
</section>
<script>
  // Команда с другой страницы: набор или режим калькулятора
  let go = false;
  try { const raw = sessionStorage.getItem('pricingGo'); if (raw) { sessionStorage.removeItem('pricingGo'); (window as any).__pricingGo = JSON.parse(raw); go = true; } } catch {}
  // Ссылка на сохраненный расчет или переход с командой: сразу к блоку цен, чтобы калькулятор загрузился
  if (/calc=/.test(location.hash) || (go && location.hash === '#pricing')) requestAnimationFrame(() => document.getElementById('pricing')!.scrollIntoView());
</script>
<style>
  .pz{background:var(--deep);color:#fff;padding:10rem 4rem}
  .pz__head :global(.badge){--badge-bg:#fff;color:var(--ink);font-weight:500}
  .pz__head :global(.badge svg){color:var(--ink)}
  .pz__head :global(.head__intro),.pz__head :global(.head__title){color:#fff}
  .pz h3{font-weight:500;letter-spacing:-.03em}
  .pz__inst{margin-top:2rem;background:var(--ink);border-radius:3.2rem;padding:4.8rem;display:grid;grid-template-columns:62rem 1fr;gap:6rem;align-items:center}
  .pz__inst h3{font-size:4.4rem;line-height:1.1}
  .pz__inst-text{margin-top:2rem;font-size:max(1.8rem,15px);line-height:1.45}
  .pz__inst-text span{display:block}
  .pz__inst-note{margin-top:1.6rem;font-size:max(1.5rem,12px);line-height:1.45;color:rgba(255,255,255,.55)}
  .pz__inst-btn{margin-top:2.8rem;height:5.8rem;padding:0 2.4rem 0 2.8rem;font-size:max(1.7rem,15px)}
  .pz__inst ul{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem}
  .pz__inst li{background:#1c1c1c;border-radius:2.4rem;padding:2.8rem 2.4rem;display:grid;gap:.8rem}
  .pz__inst li b{font-size:3.8rem;line-height:1.1;font-weight:500;letter-spacing:-.03em;color:var(--light)}
  .pz__inst li span{font-size:max(1.6rem,13px);color:rgba(255,255,255,.75)}
  .pz__guar{margin-top:2rem;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  .pz__guar li{background:#fff;color:var(--ink);border-radius:2.4rem;padding:2.8rem;display:flex;gap:1.6rem;min-height:13.2rem}
  .pz__guar li>span{flex:none;width:4.8rem;height:4.8rem;border-radius:50%;background:var(--mint);color:var(--deep)}
  .pz__guar li>span :global(svg){width:4.8rem;height:4.8rem}
  .pz__guar b{font-size:max(2rem,16px);font-weight:500}
  .pz__guar p{margin-top:.6rem;font-size:max(1.6rem,13px);line-height:1.4;color:var(--muted)}
  .pz__faq{margin-top:6rem;display:grid;grid-template-columns:42rem 1fr;gap:2rem;align-items:start}
  .pz__faq h3{margin-top:2.4rem;font-size:2.8rem;line-height:1.2}
  .pz__faq>div>p{margin-top:1.2rem;max-width:36rem;font-size:max(1.5rem,13px);line-height:1.45;color:rgba(255,255,255,.7)}
  .pz__list{display:grid;gap:1rem}
  .pz details{background:var(--card);color:var(--ink);border-radius:2rem;padding:2.4rem 2.6rem}
  .pz summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:flex-start;gap:1.6rem}
  .pz summary::-webkit-details-marker{display:none}
  .pz summary h4{margin:0;font-size:max(2rem,16px);line-height:1.3;font-weight:500;letter-spacing:-.02em}
  .pz summary i{flex:none;position:relative;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--ink);transition:background-color .25s var(--ease),transform .35s var(--ease)}
  .pz summary i::before,.pz summary i::after{content:'';position:absolute;left:28%;right:28%;top:calc(50% - 1px);height:2px;border-radius:1px;background:#fff}
  .pz summary i::after{transform:rotate(90deg);transition:opacity .2s}
  .pz details[open] summary i{background:var(--deep);transform:rotate(180deg)}
  .pz details[open] summary i::after{opacity:0}
  .pz details p{margin-top:1.2rem;font-size:max(1.7rem,14px);line-height:1.47}
  @supports (interpolate-size:allow-keywords){
    .pz details{interpolate-size:allow-keywords}
    .pz details::details-content{height:0;overflow:clip;transition:height .4s var(--ease),content-visibility .4s allow-discrete}
    .pz details[open]::details-content{height:auto}
  }
  @media (max-width:1023px){
    .pz{padding:56px 12px 24px}
    .pz__head{padding:0 8px 8px}
    .pz__head :global(.head__intro){color:rgba(255,255,255,.85)}
    .pz__inst{margin-top:12px;border-radius:20px;padding:18px;display:flex;flex-direction:column;align-items:stretch;gap:12px}
    .pz__inst h3{font-size:28px}
    .pz__inst-text{margin-top:0;font-size:15px;line-height:21px}.pz__inst-text span{display:inline}
    .pz__inst-note{margin-top:0;font-size:13px}
    .pz__inst>div{display:contents}
    .pz__inst-btn{order:5;margin:0;width:100%;height:56px;font-size:16px}
    .pz__inst ul{grid-template-columns:1fr;gap:10px}
    .pz__inst li{border-radius:16px;padding:16px;gap:4px}.pz__inst li b{font-size:26px}.pz__inst li span{font-size:15px}
    .pz__guar{margin-top:12px;grid-template-columns:1fr;gap:10px}
    .pz__guar li{border-radius:16px;padding:16px;min-height:0}.pz__guar li>span{display:none}
    .pz__guar b{font-size:17px}.pz__guar p{font-size:15px;line-height:21px}
    .pz__faq{margin-top:36px;grid-template-columns:1fr;gap:16px}
    .pz__faq>div:first-child{padding:0 8px}
    .pz__faq h3{margin:0;font-size:22px}.pz__faq>div>p{margin-top:8px;font-size:14px;max-width:none}
    .pz__list{gap:10px}
    .pz details{border-radius:16px;padding:16px}
    .pz summary h4{font-size:17px;line-height:22px}.pz summary i{width:20px;height:20px;margin-top:2px}
    .pz details p{font-size:14px;line-height:20px}
  }
  @media (min-width:768px) and (max-width:1023px){.pz{padding:56px 20px 24px}.pz__guar{grid-template-columns:repeat(3,1fr)}.pz__inst ul{grid-template-columns:repeat(3,1fr)}}
</style>
