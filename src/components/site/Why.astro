---
import { why as w, nb } from '../../i18n/ru';
import Head from '../ui/Head.astro';
import Arrow from './Arrow.astro';
---
<section class="section wy" id="why">
  <div class="wy__head"><Head badge={w.badge} icon="task" intro={w.intro} title={w.title} /></div>
  <div class="wy__table" data-reveal>
    <table>
      <thead><tr><td></td>{w.cols.map((c, i) => <th scope="col" class:list={{ me: i === 3 }}>{c}</th>)}</tr></thead>
      <tbody>
        {w.rows.map((r) => (<tr><th scope="row">{r[0]}</th>{r.slice(1).map((c, i) => <td class:list={{ me: i === 3 }}>{nb(c)}</td>)}</tr>))}
      </tbody>
    </table>
  </div>
  <ul class="wy__cards" id="why-cards">
    {w.rows.map((r, i) => (
      <li class:list={{ extra: i > 2 }} data-reveal>
        <h3>{r[0]}</h3>
        <p class="me"><span>{w.cols[3]}</span>{nb(r[4])}</p>
        {[0, 1, 2].map((k) => <p><span>{w.cols[k]}</span>{nb(r[k + 1])}</p>)}
      </li>
    ))}
  </ul>
  <button class="btn btn--white wy__all" type="button" aria-controls="why-cards" aria-expanded="false">{w.showAll}<Arrow /></button>
  <div class="wy__bottom">
    <article class="wy__ai" data-reveal>
      <h3>{w.ai.title.map((l) => <span>{l} </span>)}</h3>
      <p>{nb(w.ai.text)}</p>
    </article>
    <article class="wy__swap" data-reveal style="--d:90ms">
      <h3>{w.swap.title.map((l) => <span>{l} </span>)}</h3>
      <p>{nb(w.swap.text)}</p>
      <button class="btn btn--deep wy__btn" type="button" data-open="lead" data-task="Есть подрядчик, нужна оценка">{w.swap.btn}<Arrow /></button>
    </article>
  </div>
</section>
<script>
  const b = document.querySelector<HTMLButtonElement>('.wy__all');
  b?.addEventListener('click', () => { document.getElementById('why-cards')!.classList.add('is-all'); b.setAttribute('aria-expanded', 'true'); b.hidden = true; });
</script>
<style>
  .wy{background:var(--deep);padding:10rem 4rem;color:#fff}
  .wy__head :global(.badge){--badge-bg:#fff;color:var(--deep);font-weight:500}
  .wy__head :global(.badge svg){color:var(--deep)}
  .wy__head :global(.badge svg path){--badge-bg:#fff}
  .wy__head :global(.head__intro),.wy__head :global(.head__title){color:#fff}
  .wy__table{margin-top:11.6rem;background:#fff;color:var(--ink);border-radius:3.2rem;padding:1.6rem}
  .wy table{width:100%;border-collapse:collapse;table-layout:fixed}
  .wy col,.wy td,.wy th{text-align:left;vertical-align:top}
  .wy thead th,.wy thead td{padding:2.2rem 2rem;font-size:max(2rem,14px);line-height:1.2;font-weight:500}
  .wy thead td{width:17.2%}.wy thead th{width:20%}.wy thead th.me{width:22.8%}
  .wy tbody th,.wy tbody td{padding:1.8rem 2rem;font-size:max(1.7rem,13px);line-height:1.41;border-top:1px solid #e1e8e3}
  .wy tbody tr:first-child th,.wy tbody tr:first-child td{border-top:0}
  .wy tbody th{font-weight:500}
  .wy tbody td{color:rgba(10,10,10,.75)}
  .wy .me{background:var(--deep);color:#fff!important;font-weight:500;border-top-color:rgba(255,255,255,.15)!important}
  .wy thead .me{border-radius:2rem 2rem 0 0}
  .wy tbody tr:last-child .me{border-radius:0 0 2rem 2rem;padding-bottom:4.2rem}
  .wy tbody tr{transition:background-color .2s var(--ease)}
  .wy tbody tr:hover{background:#f6f8f6}
  .wy__cards,.wy__all{display:none}
  .wy__bottom{margin-top:2rem;display:grid;grid-template-columns:108fr 68fr;gap:2rem}
  .wy__bottom article{border-radius:3.2rem;padding:4rem;min-height:28.6rem}
  .wy__bottom h3{font-weight:500;letter-spacing:-.03em}
  .wy__bottom h3 span{display:block}
  .wy__ai{background:var(--ink)}
  .wy__ai h3{font-size:3.6rem;line-height:4.2rem}
  .wy__ai p{margin-top:1.6rem;font-size:max(1.8rem,14px);line-height:1.5;color:rgba(255,255,255,.75)}
  .wy__swap{background:#fff;color:var(--ink)}
  .wy__swap h3{font-size:3rem;line-height:3.6rem}
  .wy__swap p{margin-top:1.6rem;font-size:max(1.7rem,14px);line-height:1.47;color:rgba(10,10,10,.75)}
  .wy__btn{margin-top:1.6rem;height:5.2rem;padding:0 2rem 0 2.4rem;font-size:max(1.6rem,14px)}
  @media (max-width:1023px){
    .wy{padding:56px 12px 12px}
    .wy__head{padding:0 8px 8px}
    .wy__head :global(.head__intro){color:rgba(255,255,255,.8)}
    .wy__table{display:none}
    .wy__cards{display:grid;gap:12px;margin-top:20px}
    .wy__cards li{background:#fff;color:var(--ink);border-radius:20px;padding:18px;display:grid;gap:10px}
    .wy__cards li.extra{display:none}
    .wy__cards.is-all li.extra{display:grid}
    .wy__cards h3{font-size:18px;line-height:24px;font-weight:500}
    .wy__cards p{padding:0 14px;font-size:15px;line-height:20px;background:none}
    .wy__cards p span{display:block;font-size:12px;line-height:16px;color:var(--muted);margin-bottom:2px}
    .wy__cards p.me{padding:12px 14px;border-radius:14px;font-weight:500}
    .wy__cards p.me span{color:rgba(255,255,255,.75);font-weight:400}
    .wy__all{display:flex;width:100%;height:56px;margin-top:12px;font-size:16px}
    .wy__all[hidden]{display:none}
    .wy__bottom{grid-template-columns:1fr;gap:12px;margin-top:12px}
    .wy__bottom article{border-radius:20px;padding:18px;min-height:0}
    .wy__bottom h3 span{display:inline}
    .wy__ai h3,.wy__swap h3{font-size:22px;line-height:26px}
    .wy__ai p,.wy__swap p{margin-top:12px;font-size:15px;line-height:21px}
    .wy__btn{margin-top:14px;width:100%;height:56px;font-size:16px;background:var(--ink)}
  }
  @media (min-width:768px) and (max-width:1023px){.wy{padding:56px 20px 20px}.wy__cards,.wy__bottom{grid-template-columns:1fr 1fr}}
</style>
