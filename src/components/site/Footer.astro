---
import Logo from '../Logo.astro';
import Arrow from './Arrow.astro';
import { footer, site, nb } from '../../i18n/ru';
import { calcHref, SERVICES, serviceHref } from '../../i18n/routes';
import { BLOG_LIVE } from '../../i18n/blog';
const h = (x: string) => x;
const links = [...footer.sectionLinks, ...(BLOG_LIVE ? [{ label: 'Блог', href: '/blog/' }] : [])];
---
<footer class="section ft">
  <div class="ft__cols">
    <div class="ft__brand">
      <a class="ft__logo" href="/"><Logo size={40} /><span>{site.name}</span></a>
      <p>{nb(footer.desc)}</p>
      <div class="ft__actions">
        <button class="btn btn--white" type="button" data-open="write">{footer.write}<Arrow /></button>
        <a class="btn ft__ghost" href={calcHref(Astro.url.pathname)}>{footer.quote}<Arrow /></a>
      </div>
    </div>
    <nav class="ft__col" aria-label={footer.sections}>
      <h3>{footer.sections}</h3>
      <ul>{links.map((l) => <li><a href={h(l.href)}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="ft__col ft__col--srv" aria-label="Услуги">
      <h3>Услуги</h3>
      <ul>{SERVICES.map((s) => <li><a href={serviceHref(s.slug)}>{s.menu}</a></li>)}</ul>
    </nav>
    <div class="ft__col">
      <h3>{footer.contacts}</h3>
      <ul class="ft__hints">{footer.contactLinks.map((l) => <li><a href={h(l.href)} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener"><b>{l.label}</b><small>{l.hint}</small></a></li>)}</ul>
    </div>
    <div class="ft__col ft__col--wide">
      <h3>{footer.also}</h3>
      <ul class="ft__hints">{footer.alsoLinks.map((l) => <li><a href={h(l.href)} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener"><b>{l.label}</b><small>{l.hint}</small></a></li>)}</ul>
    </div>
  </div>
  <div class="ft__legal">
    <div><p>{footer.legal1}</p><p>{nb(footer.legal2)}</p></div>
    <div class="ft__links"><a href="/privacy">{footer.policy}</a><a href="/consent">{footer.consent}</a></div>
    <a class="ft__top" href="#top">{footer.top}<svg viewBox="0 0 14 14" width="14" height="14" fill="none" aria-hidden="true"><path d="M7 12V2M2.5 6.5 7 2l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </div>
</footer>
<style>
  .ft{background:var(--deep);color:#fff;padding:4.8rem 4rem 3.2rem;--logo-dot:var(--light)}
  .ft__cols{display:flex;gap:4rem}
  .ft__brand{width:44rem;margin-right:auto;display:flex;flex-direction:column;gap:2rem}
  .ft__logo{display:flex;align-items:center;gap:1.2rem;font-size:2.6rem;font-weight:500}
  .ft__logo :global(svg){width:4rem;height:4rem}
  .ft__brand p{color:rgba(255,255,255,.65);font-size:max(1.7rem,14px);line-height:1.47}
  .ft__actions{display:flex;gap:1rem}
  .ft__actions .btn{height:5rem;padding:0 2.4rem;font-size:max(1.6rem,14px)}
  .ft__ghost{background:rgba(255,255,255,.14);color:#fff}.ft__ghost:hover{background:rgba(255,255,255,.24)}
  .ft__col{width:20rem}.ft__col--srv{width:23rem}.ft__col--wide{width:26rem}
  .ft__col h3{font-size:max(1.4rem,12px);font-weight:500;color:rgba(255,255,255,.65);margin-bottom:1.4rem}
  .ft__col ul{display:flex;flex-direction:column;gap:1.4rem;font-size:max(1.7rem,14px);font-weight:500}
  .ft__col a{transition:opacity .2s}.ft__col a:hover{opacity:.7}
  .ft__hints a{display:flex;flex-direction:column;gap:.1rem}
  .ft__hints b{font-weight:500}.ft__hints small{font-size:max(1.4rem,12px);font-weight:400;color:rgba(255,255,255,.65)}
  .ft__legal{margin-top:4rem;padding-top:4rem;border-top:1px solid rgba(255,255,255,.2);display:flex;align-items:center;gap:3.2rem;font-size:max(1.4rem,12px);line-height:1.43;color:rgba(255,255,255,.65)}
  .ft__legal>div:first-child{margin-right:auto;display:flex;flex-direction:column;gap:.4rem}
  .ft__links{display:flex;gap:2.4rem;color:#fff;font-weight:500}
  .ft__links a{text-decoration:underline;text-underline-offset:.3em}
  .ft__top{display:inline-flex;align-items:center;gap:.8rem;height:4.2rem;padding:0 1.4rem 0 1.8rem;border-radius:999px;background:rgba(255,255,255,.14);color:#fff;font-weight:500;transition:background-color .2s}
  .ft__top:hover{background:rgba(255,255,255,.24)}
  @media (max-width:1023px){
    .ft{padding:56px 20px 24px}
    .ft__cols{flex-wrap:wrap;gap:20px 16px}
    .ft__brand{width:100%;gap:16px}
    .ft__logo{font-size:22px;gap:10px}.ft__logo :global(svg){width:32px;height:32px}
    .ft__brand p{font-size:15px;line-height:21px}
    .ft__actions{flex-direction:column;gap:8px}.ft__actions .btn{height:56px;font-size:16px}
    .ft__col{width:calc(50% - 8px)}.ft__col--wide{width:100%}
    .ft__col h3{font-size:13px;margin-bottom:10px}
    .ft__col ul{gap:10px;font-size:16px}
    .ft__hints small{font-size:13px}
    .ft__legal{margin-top:20px;padding-top:20px;flex-direction:column;align-items:flex-start;gap:14px;font-size:12px;line-height:17px}
    .ft__links{flex-direction:column;gap:10px;font-size:13px}
    .ft__top{height:40px;font-size:14px}
  }
</style>
