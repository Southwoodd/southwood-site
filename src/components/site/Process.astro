---
import { process as p, nb } from '../../i18n/ru';
import Badge from '../ui/Badge.astro';
import Ui from '../ui/Ui.astro';
---
<section class="section pc" id="process">
  <div class="head head--center">
    <Badge icon="task" reveal>{p.badge}</Badge>
    <h2 class="head__title" data-reveal style="--d:60ms">{p.title}</h2>
    <p class="head__intro" data-reveal style="--d:120ms">{nb(p.intro)}</p>
  </div>
  <ol class="pc__grid">
    {p.steps.map((s, i) => (
      <li class:list={{ hot: s.hot }} data-reveal style={`--d:${(i % 3) * 80}ms`}>
        <details class="fold pc__step" data-group="process" data-open-m={i === 0 ? '' : undefined} open>
          <summary>
            <span class="pc__ico"><Ui n={s.icon as any} /></span>
            <span class="pc__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <i class="fold__ic"></i>
          </summary>
          <p>{nb(s.text)}</p>
          <span class="pc__tag">{s.tag}</span>
        </details>
      </li>
    ))}
  </ol>
</section>
<style>
  .pc{padding:10rem 4rem}
  .pc__grid{margin-top:10rem;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  .pc__grid li{position:relative;min-height:36rem;background:var(--card);border-radius:3.2rem;padding:4rem;display:grid;align-items:end;transition:translate .35s var(--ease)}
  .pc__grid li:hover{translate:0 -.6rem}
  .pc__grid li.hot{background:var(--deep);color:#fff}
  .pc__step{width:100%}
  .pc__step summary{display:block}
  .pc__ico{position:absolute;left:4rem;top:4rem}
  .pc__num{position:absolute;right:4rem;top:5.6rem;line-height:1}
  .pc__ico{width:4.8rem;height:4.8rem;border-radius:50%;background:#fff;color:var(--deep)}
  .pc__ico :global(svg){width:4.8rem;height:4.8rem}
  .pc__num{font-size:max(1.4rem,12px)}
  .pc__step h3{font-size:4rem;line-height:4.4rem;font-weight:500;letter-spacing:-.03em}
  .pc__step p{margin-top:1.2rem;font-size:max(1.8rem,14px);line-height:1.34}
  .pc__tag{margin-top:2rem;height:3.2rem;padding:0 1.4rem;border-radius:999px;background:#fff;color:var(--ink);font-size:max(1.4rem,12px);font-weight:500;display:inline-flex;align-items:center}
  .hot .pc__tag{color:var(--deep)}
  @media (max-width:1023px){
    .pc{padding:56px 12px 12px}
    .pc :global(.head){padding:0 8px 8px;align-items:center}
    .pc__grid{margin-top:20px;grid-template-columns:1fr;gap:12px}
    .pc__grid li{min-height:0;border-radius:20px;padding:18px;display:block}
    .pc__grid li:hover{translate:none}
    .pc__step summary{display:grid;grid-template-columns:1fr auto;row-gap:6px;align-items:center}
    .pc__ico{display:none}
    .pc__num{position:static;grid-column:1;grid-row:1;font-size:13px}
    .pc__step h3{grid-column:1;grid-row:2;font-size:26px;line-height:30px}
    .pc__step :global(.fold__ic){grid-column:2;grid-row:1/3}
    .pc__step[open] :global(.fold__ic){background:var(--deep)}
    .hot :global(.fold__ic){background:#fff!important}
    .hot :global(.fold__ic)::before,.hot :global(.fold__ic)::after{background:var(--deep)}
    .pc__step p{margin-top:10px;font-size:15px;line-height:21px}
    .pc__tag{margin-top:12px;height:32px;font-size:14px}
  }
  @media (min-width:768px) and (max-width:1023px){.pc{padding:56px 20px 20px}.pc__grid{grid-template-columns:1fr 1fr}}
</style>
