      const k = d > 0 ? (ci + 1) % scenes.length : tt - scenes[ci].start > 1.2 ? ci : (ci + scenes.length - 1) % scenes.length; t = scenes[k].start + 0.02; draw(); goal('reel_seek'); };
    if (port) { let dn = 0, dx = 0, dy = 0, hold = 0;
