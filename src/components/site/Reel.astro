    sfxTick = (i) => { if (sndOn && sfx && !api.manual) sfx.tick(i); };
    sndBtn.addEventListener('click', () => { if (!sfx) sfx = mkSfx(); if (!sfx) { sndBtn.hidden = true; return; } sndOn = !sndOn; sfx.set(sndOn); sndBtn.setAttribute('aria-pressed', String(sndOn)); if (sndOn) { sfx.pop(); goal('reel_sound'); } });
    // Панель кейса
    const esc = (x: string) => String(x).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    let pnBack: HTMLElement | null = null;
    const openPn = (key: string) => { const c = D.panel[key]; if (!c) return false; const cc = D.cases.find((x: V) => x.key === key);
