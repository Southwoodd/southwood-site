      pnC.scrollTop = 0; pnBack = document.activeElement as HTMLElement | null; lock = true; hot = null; pn.hidden = false; void pn.offsetWidth; pn.classList.add('is-open'); pnBox.focus({ preventScroll: true });
      onNow && onNow.vids!.forEach((v) => v.pause()); if (sndOn && sfx) sfx.pop(); return true; };
    const closePn = () => { if (!lock) return; lock = false; pn.classList.remove('is-open'); setTimeout(() => { if (!lock) pn.hidden = true; }, 320); pnBack && pnBack.isConnected && pnBack.focus({ preventScroll: true }); play(); };
    // Тип бизнеса: сам меняется на каждом круге, пока человек не выбрал свой
    chips.innerHTML = VARS.map((v, i) => `<button type="button" data-v="${i}" aria-pressed="${!i}">${v.name}</button>`).join('');
    const chipEls = [...chips.querySelectorAll<HTMLElement>('button')]; let pick = -1, curVar = 0;
    const setVar = (i: number) => { if (i === curVar) return; curVar = i; applyVar(i); chipEls.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i))); };
    const draw = () => {
      const tt = ((t % T) + T) % T; let ci = 0; scenes.forEach((s, i) => { if (tt >= s.start) ci = i; });
      const s = scenes[ci], lt = tt - s.start, nx = scenes[(ci + 1) % scenes.length], pv = scenes[(ci + scenes.length - 1) % scenes.length];
      setVar(film || reduce ? Math.max(pick, 0) : pick >= 0 ? pick : Math.max(0, Math.floor(t / T)) % VARS.length); chips.classList.toggle('is-off', s.id !== 'sys' || lock);
      const hold = film && ci === scenes.length - 1; // в файле ролик заканчивается на финальном кадре, без ухода
