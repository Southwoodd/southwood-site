      scenes.forEach((x) => x.el.classList.toggle('is-on', x === s));
      arm(s); arm(nx);
      if (onNow !== s && started) { try { sessionStorage.setItem('reelAt', String(ci)); } catch (e) {}
        if (s.id === 'outro' && !doneSent) { doneSent = true; goal('reel_done'); } }
      if (onNow !== s && started && sndOn && sfx && !api.manual) sfx.whoosh(ci);
      if (onNow !== s) { onNow && onNow.vids!.forEach((v) => v.pause()); s.vids!.forEach((v) => { try { v.currentTime = 0; } catch (e) {} }); onNow = s; }
      s.vids!.forEach((v) => { if (api.manual) { if (v.readyState > 0 && v.duration) v.currentTime = Math.min(lt, v.duration - 0.05); }
        else if (lock) { if (!v.paused) v.pause(); }
        else { v.playbackRate = Math.max(0.1, Math.min(1, speed)); if (v.paused && vis) v.play().catch(() => {}); } });
      s.up(lt, s);
      s.el.style.transform = `translateZ(${(out * 900 - (1 - oExpo(inn)) * 500).toFixed(1)}px)`;
      s.el.style.opacity = (cl(inn * 3) * (1 - out)).toFixed(3);
      const bl = out * 14 + (1 - cl(inn * 2.2)) * 10; s.el.style.filter = bl > 0.3 ? `blur(${bl.toFixed(1)}px)` : '';
      // Самый первый кадр идет без вспышки: до старта блок стоит спокойным фоном
      const fl = (t < 0.6 ? 0 : Math.exp(-Math.pow(lt / 0.16, 2))) + (hold ? 0 : Math.exp(-Math.pow((s.dur - lt) / 0.14, 2)));
      flash.style.opacity = (fl * 0.5).toFixed(3);
      const k = oCub(sg(lt, 0, 0.6)), k2 = iCub(sg(lt, s.dur - 0.3, s.dur)) * 0.5;
      const A = s.a.map((v, i) => mix(mix(pv.a[i], v, 0.5 + 0.5 * k), nx.a[i], k2)), B = s.b.map((v, i) => mix(mix(pv.b[i], v, 0.5 + 0.5 * k), nx.b[i], k2));
      root.style.setProperty('--fl', `rgb(${B.map((v) => Math.round(v * 255)).join(',')})`);
      if (gl) { const rg = s.ring ? s.ring(lt, s) : null;
        gl.uniform2f(U.uRes, cv.width, cv.height); gl.uniform1f(U.uT, t); gl.uniform1f(U.uFlash, fl); gl.uniform3fv(U.uA, A); gl.uniform3fv(U.uB, B);
        gl.uniform1f(U.uRing, rg ? rg.o * (1 - out) : 0); gl.uniform3f(U.uRP, rg ? rg.x : 0, rg ? rg.y * (port ? 0.7 : 1) : 0, rg ? rg.s * (port ? 0.5 : 1) : 1); gl.uniformMatrix3fv(U.uRot, false, rotM(rg ? rg.rot : [0, 0, 0]));
        gl.drawArrays(gl.TRIANGLES, 0, 3); }
