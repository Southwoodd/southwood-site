      if (port && mgo.dataset.s !== s.id) { mgo.dataset.s = s.id; const lab = n >= 0 ? 'Смотреть кейс →' : s.id === 'sys' ? 'Все услуги →' : s.id === 'more' ? 'Все кейсы →' : '';
        mgo.hidden = !lab; mwant.hidden = n < 0; root.classList.toggle('rl--two', n >= 0);
        if (lab) { mgo.textContent = lab; mgo.href = n >= 0 ? D.cases[n].href : s.id === 'more' ? D.all : '/uslugi/'; mgo.dataset.rlEv = n >= 0 ? 'reel_open' : s.id === 'more' ? 'reel_all' : 'reel_services'; mgo.dataset.rlCase = s.id; }
        if (n >= 0) { mwant.dataset.sub = 'Хочу проект как ' + D.cases[n].name; mwant.dataset.context = 'reel:' + s.id; mwant.dataset.rlEv = 'reel_want'; mwant.dataset.rlCase = s.id; } }
      nowEl.textContent = n >= 0 ? `0${n + 1} / 0${D.cases.length}  ${s.label}` : s.label;
      segs.forEach((b, i) => b.style.setProperty('--p', String(i < ci ? 1 : i > ci ? 0 : lt / s.dur)));
