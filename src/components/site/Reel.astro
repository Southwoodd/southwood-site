      const PENT = [0, 3, 5, 7, 10, 12, 15, 17], nt = (base: number, i: number) => base * Math.pow(2, PENT[i % PENT.length] / 12);
      const tone = (f: number, dur: number, vol: number, type: OscillatorType = 'sine', at = 0) => { const o = ac.createOscillator(), g = ac.createGain(), t0 = ac.currentTime + at; o.type = type; o.frequency.value = f; env(g, t0, vol, 0.012, dur); o.connect(g); g.connect(out); o.start(t0); o.stop(t0 + dur + 0.05); };
      return { set(v: boolean) { if (v) { ac.resume(); if (!timer) timer = window.setInterval(sched, 60); } else { clearInterval(timer); timer = 0; } out.gain.setTargetAtTime(v ? 0.6 : 0, ac.currentTime, v ? 0.3 : 0.1); },
        live(v: boolean) { if (v && sndOn) ac.resume(); else if (!v) ac.suspend(); },
        whoosh(i: number) { const src = ac.createBufferSource(), bp = ac.createBiquadFilter(), g = ac.createGain(), t0 = ac.currentTime; src.buffer = nb; bp.type = 'bandpass'; bp.Q.value = 0.7;
          bp.frequency.setValueAtTime(400, t0); bp.frequency.exponentialRampToValueAtTime(2200, t0 + 0.5); g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(0.11, t0 + 0.22); g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.6);
