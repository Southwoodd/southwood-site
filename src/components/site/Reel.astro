          if (st % 4 === 2) hit(t0, 7500, 0.022, 0.045);
          if (st % 2 === 0 && st !== 0 && rnd() < 0.2) key(LEAD[Math.floor(rnd() * LEAD.length)], t0, 0.022, 1.3);
