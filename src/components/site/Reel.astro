    const api = { T, manual: false, scenes: scenes.map((s) => ({ id: s.id, start: s.start, dur: s.dur })), seek(v: number) { t = v; draw(); }, hold(v: boolean) { api.manual = v; if (!v) play(); } };
    (window as V).__reel = api;

    if (!port) root.addEventListener('pointermove', (e) => { const r = root.getBoundingClientRect(); mX = e.clientX - r.left; mY = e.clientY - r.top;
      const l = (e.target as HTMLElement).closest<HTMLElement>('[data-rl-link]'); if (l !== hot) { hot = l; if (l) curTx.textContent = l.getAttribute('data-rl-link'); }
      want = reduce ? 0 : l || (e.target as HTMLElement).closest('.rl__cta,.rl__bar,.rl__chips') ? 0.06 : 1; });
    if (!port) root.addEventListener('pointerleave', () => { hot = null; want = reduce ? 0 : 1; });
    bar.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return; t = scenes[+b.dataset.i!].start + (reduce ? 1.8 : 0.02); draw(); goal('reel_seek'); });
    // Листание: тап и свайп на телефоне, стрелки на клавиатуре
