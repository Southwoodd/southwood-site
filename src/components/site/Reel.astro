      const s = scenes[ci], lt = tt - s.start, nx = scenes[(ci + 1) % scenes.length], pv = scenes[(ci + scenes.length - 1) % scenes.length];
      const out = iCub(sg(lt, s.dur - 0.45, s.dur)), inn = sg(lt, 0, 0.5);
      scenes.forEach((x) => x.el.classList.toggle('is-on', x === s));
      arm(s); arm(nx);
      if (onNow !== s) { onNow && onNow.vids!.forEach((v) => v.pause()); s.vids!.forEach((v) => { try { v.currentTime = 0; } catch (e) {} }); onNow = s; }
      s.vids!.forEach((v) => { if (api.manual) { if (v.readyState > 0 && v.duration) v.currentTime = Math.min(lt, v.duration - 0.05); }
        else { v.playbackRate = Math.max(0.1, Math.min(1, speed)); if (v.paused && vis) v.play().catch(() => {}); } });
      s.up(lt, s);
      s.el.style.transform = `translateZ(${(out * 900 - (1 - oExpo(inn)) * 500).toFixed(1)}px)`;
      s.el.style.opacity = (cl(inn * 3) * (1 - out)).toFixed(3);
      const bl = out * 14 + (1 - cl(inn * 2.2)) * 10; s.el.style.filter = bl > 0.3 ? `blur(${bl.toFixed(1)}px)` : '';
      // Самый первый кадр идет без вспышки: до старта блок стоит спокойным фоном
      const fl = (t < 0.6 ? 0 : Math.exp(-Math.pow(lt / 0.16, 2))) + Math.exp(-Math.pow((s.dur - lt) / 0.14, 2));
      flash.style.opacity = (fl * 0.5).toFixed(3);
      const k = oCub(sg(lt, 0, 0.6)), k2 = iCub(sg(lt, s.dur - 0.3, s.dur)) * 0.5;
      const A = s.a.map((v, i) => mix(mix(pv.a[i], v, 0.5 + 0.5 * k), nx.a[i], k2)), B = s.b.map((v, i) => mix(mix(pv.b[i], v, 0.5 + 0.5 * k), nx.b[i], k2));
      root.style.setProperty('--fl', `rgb(${B.map((v) => Math.round(v * 255)).join(',')})`);
      if (gl) { const rg = s.ring ? s.ring(lt, s) : null;
        gl.uniform2f(U.uRes, cv.width, cv.height); gl.uniform1f(U.uT, t); gl.uniform1f(U.uFlash, fl); gl.uniform3fv(U.uA, A); gl.uniform3fv(U.uB, B);
        gl.uniform1f(U.uRing, rg ? rg.o * (1 - out) : 0); gl.uniform3f(U.uRP, rg ? rg.x : 0, rg ? rg.y : 0, rg ? rg.s : 1); gl.uniformMatrix3fv(U.uRot, false, rotM(rg ? rg.rot : [0, 0, 0]));
        gl.drawArrays(gl.TRIANGLES, 0, 3); }
      const n = D.cases.findIndex((c: V) => c.key === s.id);
      nowEl.textContent = n >= 0 ? `0${n + 1} / 0${D.cases.length}  ${s.label}` : s.label;
      segs.forEach((b, i) => b.style.setProperty('--p', String(i < ci ? 1 : i > ci ? 0 : lt / s.dur)));
      s.el.classList.toggle('is-hot', !!hot && s.el.contains(hot));
    };
    const loop = (now: number) => { raf = 0; const dt = Math.min(0.05, (now - last) / 1000 || 0); last = now;
      speed += (want - speed) * Math.min(1, dt * 7); t += dt * speed;
      curX += (mX - curX) * 0.22; curY += (mY - curY) * 0.22; curO += ((hot ? 1 : 0) - curO) * 0.2;
      cur.style.transform = `translate(${curX.toFixed(1)}px,${curY.toFixed(1)}px) scale(${(0.4 + 0.6 * curO).toFixed(3)})`; cur.style.opacity = curO.toFixed(2);
      draw(); if (vis && !api.manual) raf = requestAnimationFrame(loop); };
    const play = () => { if (!raf && vis && !api.manual) { last = performance.now(); raf = requestAnimationFrame(loop); } };
    const api = { T, manual: false, scenes: scenes.map((s) => ({ id: s.id, start: s.start, dur: s.dur })), seek(v: number) { t = v; draw(); }, hold(v: boolean) { api.manual = v; if (!v) play(); } };
    (window as V).__reel = api;

    root.addEventListener('pointermove', (e) => { const r = root.getBoundingClientRect(); mX = e.clientX - r.left; mY = e.clientY - r.top;
      const l = (e.target as HTMLElement).closest<HTMLElement>('[data-rl-link]'); if (l !== hot) { hot = l; if (l) curTx.textContent = l.getAttribute('data-rl-link'); }
      want = reduce ? 0 : l || (e.target as HTMLElement).closest('.rl__cta,.rl__bar') ? 0.06 : 1; });
    root.addEventListener('pointerleave', () => { hot = null; want = reduce ? 0 : 1; });
    bar.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return; t = scenes[+b.dataset.i!].start + (reduce ? 1.8 : 0.02); draw(); (window as V).swGoal && (window as V).swGoal('reel_seek'); });
    stage.addEventListener('click', (e) => { const l = (e.target as HTMLElement).closest('a[data-rl-link]'); if (l) (window as V).swGoal && (window as V).swGoal('reel_open'); });
    // Ролик стартует с начала, когда блок наполовину вошел в экран, и встает на паузу, когда ушел
    let started = false;
    new IntersectionObserver((en) => { const r = en[0].intersectionRatio;
      if (r >= 0.5) { vis = true; if (!started) { started = true; if (!reduce) t = 0; } play(); }
      else if (r < 0.05) { vis = false; onNow && onNow.vids!.forEach((v) => v.pause()); } }, { threshold: [0, 0.05, 0.5] }).observe(root);
    document.addEventListener('visibilitychange', () => { if (document.hidden) { vis = false; onNow && onNow.vids!.forEach((v) => v.pause()); } else if (started) { const b = root.getBoundingClientRect(); vis = b.bottom > 0 && b.top < innerHeight; play(); } });
    if (reduce) { want = 0; speed = 0; t = scenes[1].start + 1.8; }
    draw(); play();
  }
  // Скрытый блок (телефон) не запускаем и ничего для него не грузим; если он появится, запустим
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((r) => {
    if (r.offsetWidth) return boot(r);
    const ro = new ResizeObserver(() => { if (r.offsetWidth) { ro.disconnect(); boot(r); } }); ro.observe(r);
  });
</script>
