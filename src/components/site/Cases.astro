---
import { cases as c, nb } from '../../i18n/ru';
import Head from '../ui/Head.astro';
import Arrow from './Arrow.astro';
import { caseHref, R_, CASES_N } from '../../i18n/routes';
// keys: какие большие карточки показать. full: фильтр и список небольших работ, как на странице кейсов.
interface Props { keys?: string[]; full?: boolean; head?: boolean; title?: string[]; intro?: string; badge?: string }
const { keys, full = false, head = true, title = c.title, intro = c.intro, badge = c.badge } = Astro.props;
const list = keys ? keys.map((k) => c.list.find((x) => x.key === k)).filter(Boolean) as typeof c.list : c.list;
const small = keys ? keys.filter((k) => !c.list.some((x) => x.key === k)).map((k) => c.more.list.find((m) => m.key === k)).filter(Boolean) as typeof c.more.list : [];
---
<section class:list={['section cs', { 'cs--top': !head }]} id="cases">
  {head && <Head badge={badge} icon="flash" intro={intro} title={title} />}
  {full && <div class="cs__filter" role="group" aria-label="Фильтр кейсов" data-reveal>
    {c.filters.map((f, i) => <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
  </div>}
  <ul class:list={['cs__grid', { 'cs__grid--even': !full && list.length === 2 }]}>
    {list.map((x, i) => (
      <li class={`cs__card cs__card--${x.theme}`} data-cats={x.cats} data-reveal style={`--w:${x.w};--d:${(i % 2) * 90}ms`}>
        <div class="cs__vis" style={`aspect-ratio:${x.vw}/${x.vh}`}><img src={`/img/cases/${x.key}.webp`} width={x.vw * 2} height={x.vh * 2} alt={`${x.name}: экраны проекта`} loading="lazy" decoding="async" /></div>
        <ul class="cs__tags">{x.tags.map((t) => <li>{t}</li>)}</ul>
        <h3 class:list={{ big: x.big }}><a href={caseHref(x.key)} aria-label={`${c.open}: ${x.name}`}>{x.name}</a></h3>
        <p class="cs__text" style={`max-width:${x.tw}rem`}>{nb(x.text)}</p>
        <div class="cs__foot">
          <span class="cs__metric">{nb(x.metric)}</span>
          <span class="cs__links">{x.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}<Arrow /></a>)}</span>
        </div>
      </li>
    ))}
  </ul>
  {full && (
  <details class="fold cs__more" open>
    <summary><div><h3>{c.more.title}</h3><p>{c.more.sub}</p></div><i class="fold__ic"></i></summary>
    <ul>
      {c.more.list.map((m, i) => (
        <li data-cats={m.cats} data-reveal style={`--d:${i * 70}ms`}>
          <div><b>{m.name}</b><span>{m.tag}</span></div>
          <p>{nb(m.text)}</p>
          <p class="cs__acts">
            <a class="cs__open" href={caseHref(m.key)} aria-label={`${c.open}: ${m.name}`}>{c.details}<Arrow /></a>
            {'link' in m && <a href={m.link.href} target="_blank" rel="noopener">{m.link.label}<Arrow /></a>}
          </p>
        </li>
      ))}
    </ul>
  </details>
  )}
  {small.length > 0 && (
    <ul class="cs__small">
      {small.map((m) => (
        <li><a href={caseHref(m.key)}><span><b>{m.name}</b><em>{m.tag}</em></span><p>{nb(m.text)}</p><i>{c.details}<Arrow /></i></a></li>
      ))}
    </ul>
  )}
  {!full && <p class="sec__more"><a class="btn btn--deep" href={R_.cases}>Все {CASES_N} кейсов<Arrow /></a></p>}
</section>
<script>
  const root = document.getElementById('cases')!;
  if (root.querySelector('[data-filter]')) {
  const btns = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = root.querySelectorAll<HTMLElement>('[data-cats]');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter!;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const apply = () => items.forEach((el) => { el.hidden = f !== 'all' && !el.dataset.cats!.split(' ').includes(f); });
    const d = document as any;
    if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(apply); else apply();
    const more = root.querySelector<HTMLElement>('.cs__more')!;
    requestAnimationFrame(() => { more.classList.toggle('is-empty', !more.querySelector('li:not([hidden])')); });
  }));
  }
</script>
<style>
  .cs{padding:10rem 4rem}
  .cs--top{padding-top:4rem}.cs--top .cs__grid{margin-top:0}.cs--top .cs__filter{margin-top:0;margin-bottom:3.2rem}
  .cs__grid--even :global(.cs__card){--w:880!important}
  .cs__small{margin-top:2rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(40rem,1fr));gap:2rem}
  .cs__small a{height:100%;background:var(--card);border-radius:2.4rem;padding:2.8rem;display:grid;gap:1.2rem;transition:background-color .2s var(--ease)}
  .cs__small a:hover{background:var(--mint)}
  .cs__small span{display:flex;justify-content:space-between;align-items:center;gap:1.2rem}
  .cs__small b{font-size:2.6rem;font-weight:500;letter-spacing:-.02em}
  .cs__small em{font-style:normal;height:3rem;padding:0 1.2rem;border-radius:999px;background:#fff;display:flex;align-items:center;font-size:max(1.4rem,12px);white-space:nowrap}
  .cs__small p{font-size:max(1.6rem,14px);line-height:1.45;color:var(--muted)}
  .cs__small i{font-style:normal;display:inline-flex;align-items:center;gap:.6rem;font-size:max(1.6rem,13px);font-weight:500;color:var(--deep)}
  .cs__small :global(.arrow){width:1.8rem;height:1.8rem}
  @media (max-width:1023px){.cs--top{padding-top:20px}.cs--top .cs__filter{margin-bottom:14px}.cs__small{margin-top:10px;grid-template-columns:1fr;gap:10px}.cs__small a{border-radius:20px;padding:18px}.cs__small b{font-size:20px}.cs__small em{font-size:12px}.cs__small p{font-size:14px}.cs__small i{font-size:14px}}
  .cs__filter{margin-top:1.8rem;display:flex;flex-wrap:wrap;gap:.8rem}
  .cs__filter button{height:4.2rem;padding:0 1.8rem;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:max(1.5rem,13px);font-weight:500;transition:background-color .2s var(--ease),color .2s var(--ease),border-color .2s var(--ease)}
  .cs__filter button:hover{background:var(--mint)}
  .cs__filter button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:#fff}
  .cs__grid{margin-top:4rem;display:flex;flex-wrap:wrap;gap:2rem}
  .cs__card{position:relative;flex:1 1 calc(var(--w) * .1rem);min-width:0;min-height:64rem;border-radius:3.2rem;padding:3rem;display:flex;flex-direction:column;transition:transform .35s var(--ease),box-shadow .35s var(--ease)}
  .cs__card[hidden]{display:none}
  .cs__card:hover{transform:translateY(-.6rem);box-shadow:0 2.4rem 5rem rgba(10,30,20,.12)}
  .cs__card--light{background:var(--card)}
  .cs__card--black{background:#000;color:#fff}
  .cs__card--green{background:var(--deep);color:#fff}
  .cs__vis{border-radius:1.8rem;overflow:hidden;background:#fff;width:100%}
  .cs__card--black .cs__vis{background:#f6f6f6}.cs__card--green .cs__vis{background:rgba(255,255,255,.12)}
  .cs__vis img{width:100%;height:100%;object-fit:cover;object-position:left top;transition:transform .7s var(--ease)}
  .cs__card:hover .cs__vis img{transform:scale(1.03)}
  .cs__tags{margin-top:3rem;display:flex;flex-wrap:wrap;gap:.8rem}
  .cs__tags li{height:3rem;padding:0 1.4rem;border-radius:999px;background:#fff;color:var(--deep);font-size:max(1.4rem,12px);font-weight:500;display:flex;align-items:center;white-space:nowrap}
  .cs__card--black .cs__tags li{background:#282828;color:#fff}
  .cs__card--green .cs__tags li{background:rgba(255,255,255,.16);color:#fff}
  .cs h3{font-weight:500;letter-spacing:-.03em}
  .cs__card h3{margin-top:1.6rem;font-size:3.6rem;line-height:4rem}
  .cs__card h3.big{font-size:4.8rem;line-height:5.2rem}
  .cs__card h3 a{display:block}
  .cs__card h3 a::after{content:'';position:absolute;inset:0;border-radius:3.2rem}
  .cs__text{margin-top:1rem;font-size:max(2rem,15px);line-height:1.3}
  .cs__card--black .cs__text,.cs__card--green .cs__text{color:rgba(255,255,255,.8)}
  .cs__foot{margin-top:auto;padding-top:2.4rem;display:flex;justify-content:space-between;align-items:center;gap:1.6rem}
  .cs__metric{height:4.2rem;padding:0 1.6rem;border-radius:999px;background:var(--deep);color:#fff;font-size:max(1.8rem,14px);font-weight:500;display:flex;align-items:center;white-space:nowrap}
  .cs__card--black .cs__metric{background:var(--accent);color:#000}
  .cs__card--green .cs__metric{background:#fff;color:var(--deep)}
  .cs__links{position:relative;z-index:1;display:flex;gap:1.6rem}
  .cs__links a,.cs__more a{display:inline-flex;align-items:center;gap:.6rem;font-size:max(1.8rem,14px);font-weight:500;white-space:nowrap}
  .cs__links a :global(.arrow),.cs__more a :global(.arrow){width:1.8rem;height:1.8rem;transition:transform .25s var(--ease)}
  .cs__links a:hover :global(.arrow),.cs__more a:hover :global(.arrow){transform:translate(.2rem,-.2rem)}
  .cs__links a:hover{text-decoration:underline;text-underline-offset:.4rem}

  .cs__more{margin-top:2rem;display:grid;grid-template-columns:26rem 1fr;gap:2rem;align-items:start}
  .cs__more.is-empty{display:none}
  .cs__more summary{padding-top:2.8rem}
  .cs__more summary h3{font-size:2.8rem;line-height:3.2rem}
  .cs__more summary p{margin-top:.8rem;font-size:max(1.6rem,13px);color:var(--muted)}
  .cs__more ul{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  .cs__more li{position:relative;min-height:17rem;background:var(--card);border-radius:2.4rem;padding:2.8rem;display:flex;flex-direction:column;gap:1rem;align-items:flex-start}
  .cs__more li[hidden]{display:none}
  .cs__more li div{width:100%;display:flex;justify-content:space-between;align-items:center;gap:1.2rem}
  .cs__acts{margin-top:auto;width:100%;display:flex;justify-content:space-between;align-items:center;gap:1.6rem}
  .cs__acts a{position:relative;z-index:1}
  .cs__acts a:hover{text-decoration:underline;text-underline-offset:.4rem}
  .cs__open{display:inline-flex;align-items:center;gap:.6rem;font-size:max(1.6rem,13px);font-weight:500;color:var(--deep);white-space:nowrap}
  .cs__open::after{content:'';position:absolute;inset:0;border-radius:2.4rem}
  .cs__open :global(.arrow){width:1.8rem;height:1.8rem;transition:transform .25s var(--ease)}
  .cs__more li:has(.cs__open){transition:background-color .2s var(--ease)}
  .cs__more li:has(.cs__open):hover{background:var(--mint)}
  .cs__more li:has(.cs__open):hover :global(.arrow){transform:translate(.2rem,-.2rem)}
  .cs__more b{font-size:2.4rem;line-height:2.8rem;font-weight:500}
  .cs__more li span{flex:none;height:3rem;padding:0 1.2rem;white-space:nowrap;border-radius:999px;background:#fff;font-size:max(1.4rem,12px);font-weight:500;display:flex;align-items:center}
  .cs__more li p{font-size:max(1.6rem,13px);line-height:1.38}
  .cs__more a{font-size:max(1.6rem,13px);color:var(--deep)}
  @media (max-width:1023px){
    .cs{padding:56px 12px 12px}
    .cs :global(.head){padding:0 8px 8px}
    .cs__filter{margin-top:14px;gap:6px}
    .cs__filter button{height:38px;padding:0 14px;font-size:15px;border:0;background:var(--card)}
    .cs__grid{margin-top:16px;flex-direction:column;gap:12px}
    .cs__card{flex:none;min-height:0;border-radius:20px;padding:14px}
    .cs__card:hover{transform:none;box-shadow:none}
    .cs__vis{border-radius:12px;aspect-ratio:320/190!important}
    .cs__tags{margin-top:12px;gap:6px}
    .cs__tags li{height:38px;padding:0 12px;font-size:14px}
    .cs__card h3,.cs__card h3.big{margin-top:14px;font-size:26px;line-height:30px}
    .cs__text{margin-top:10px;font-size:15px;line-height:21px;max-width:none!important}
    .cs__foot{flex-direction:column;align-items:flex-start;gap:12px;padding-top:14px}
    .cs__metric{height:auto;min-height:38px;padding:8px 14px;font-size:15px;white-space:normal}
    .cs__links{width:100%;gap:8px}
    .cs__links a{flex:1;justify-content:center;height:48px;border-radius:999px;background:rgba(0,0,0,.06);font-size:15px}
    .cs__card--black .cs__links a,.cs__card--green .cs__links a{background:rgba(255,255,255,.14)}
    .cs__more{margin-top:12px;display:block;background:var(--card);border-radius:20px;padding:18px}
    .cs__more summary{padding:0}
    .cs__more summary h3{font-size:19px;line-height:24px}.cs__more summary p{margin-top:4px;font-size:15px}
    .cs__more ul{display:flex;flex-direction:column;gap:8px;margin-top:14px}
    .cs__more li{min-height:0;background:#fff;border-radius:14px;padding:14px;gap:6px}
    .cs__more b{font-size:17px;line-height:22px}.cs__more li span{background:var(--card);height:26px}
  }
  @media (min-width:768px) and (max-width:1023px){
    .cs{padding:56px 20px 20px}
    .cs__grid{flex-direction:row}.cs__card{flex:1 1 320px}
    .cs__more ul{flex-direction:row;flex-wrap:wrap}.cs__more li{flex:1 1 280px}
  }
</style>
