---
import { packages as p, nb } from '../../i18n/ru';
import Head from '../ui/Head.astro';
import Ui from '../ui/Ui.astro';
import Arrow from './Arrow.astro';
---
<section class="section pk" id="packages">
  <Head badge={p.badge} icon="task" intro={p.intro} title={p.title} />
  <ul class="pk__grid">
    {p.list.map((x, i) => (
      <li class:list={['pk__card', { 'pk__card--hot': x.tag }]} data-reveal style={`--d:${i * 80}ms`} data-pack={x.key}>
        <div class="pk__top"><span class="pk__ico"><Ui n={x.icon as any} /></span>{x.tag && <span class="pk__tag">{x.tag}</span>}</div>
        <h3><button type="button" data-open="pack" data-pack={x.key}>{x.name}</button></h3>
        <p class="pk__sub">{x.sub}</p>
        <div class="pk__inc">
          <span>{p.included}</span>
          <ul>{x.items.map((it) => <li><Ui n="tick" class="pk__tick" />{it}</li>)}</ul>
        </div>
        <div class="pk__bottom">
          <b class="pk__price">{nb(x.price)}</b>
          <p class="pk__term"><span>{x.term}</span><i> · </i><span class="pk__month">{nb(x.month)}</span></p>
          <a class="btn pk__btn" href="#pricing" data-pack={x.key}>{p.btn}<Arrow /></a>
        </div>
      </li>
    ))}
  </ul>
  <div class="pk__custom" data-reveal>
    <div class="pk__cl">
      <span class="pk__ico"><Ui n="custom" /></span>
      <h3>{p.custom.name}</h3>
      <p>{nb(p.custom.text)}</p>
    </div>
    <ul class="pk__chips">{p.custom.chips.map((c) => <li class:list={{ on: c.on }}><Ui n={c.icon as any} />{c.label}</li>)}</ul>
    <div class="pk__cr">
      <b class="pk__price">{nb(p.custom.price)}</b>
      <p>{p.custom.sub}</p>
      <a class="btn btn--ink pk__cbtn" href="#pricing" data-go="calc">{p.custom.btn}<Arrow /></a>
    </div>
  </div>
  <p class="pk__note">{nb(p.note)}</p>
</section>
<style>
  .pk{padding:10rem 4rem}
  .pk__grid{margin-top:10.6rem;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}
  .pk__card{position:relative;background:var(--card);border-radius:3.2rem;padding:4rem;min-height:74rem;display:flex;flex-direction:column;transition:transform .35s var(--ease),box-shadow .35s var(--ease)}
  .pk__card:hover{transform:translateY(-.6rem);box-shadow:0 2.4rem 5rem rgba(10,30,20,.1)}
  .pk__card--hot{background:var(--deep);color:#fff}
  .pk__top{display:flex;justify-content:space-between;align-items:center;height:4.8rem}
  .pk__ico{width:4.8rem;height:4.8rem;border-radius:50%;background:#fff;color:var(--deep);display:grid;place-items:center}
  .pk__ico :global(svg){width:4.8rem;height:4.8rem}
  .pk__tag{height:3rem;padding:0 1.4rem;border-radius:999px;background:#fff;color:var(--deep);font-size:max(1.4rem,12px);font-weight:500;display:flex;align-items:center}
  .pk h3{font-size:4.8rem;line-height:5.2rem;font-weight:500;letter-spacing:-.03em}
  .pk__card h3{margin-top:4rem}
  .pk__card h3 button{font:inherit;text-align:left}
  .pk__card h3 button::after{content:'';position:absolute;inset:0;border-radius:3.2rem}
  .pk__sub{margin-top:1.2rem;font-size:max(2.2rem,15px);line-height:1.27}
  .pk__card--hot .pk__sub{color:rgba(255,255,255,.85)}
  .pk__inc{margin-top:3.6rem;background:#fff;color:var(--ink);border-radius:1.8rem;padding:2.4rem;display:grid;gap:1.4rem}
  .pk__inc>span{font-size:max(1.4rem,12px);color:var(--muted)}
  .pk__inc ul{display:grid;gap:1.4rem}
  .pk__inc li{display:flex;align-items:center;gap:1.2rem;font-size:max(1.8rem,14px);line-height:1.22}
  .pk :global(.pk__tick){width:2.2rem;height:2.2rem;color:var(--deep)}
  .pk__bottom{margin-top:auto;padding-top:3rem;display:flex;flex-direction:column}
  .pk__price{font-size:4rem;line-height:4.4rem;font-weight:500;letter-spacing:-.03em}
  .pk__term{margin-top:.8rem;display:grid;gap:.4rem;font-size:max(1.8rem,14px);color:var(--muted)}
  .pk__term i{display:none}
  .pk__month{font-size:max(1.6rem,13px);font-weight:500;color:var(--deep)}
  .pk__card--hot .pk__term{color:rgba(255,255,255,.75)}.pk__card--hot .pk__month{color:var(--light)}
  .pk__btn{position:relative;z-index:1;margin-top:2.8rem;height:5.8rem;background:var(--ink);color:#fff;font-size:max(1.8rem,15px)}
  .pk__btn :global(.arrow){display:none}
  .pk__btn:hover{background:var(--deep)}
  .pk__card--hot .pk__btn{height:6rem;background:#fff;color:var(--deep)}
  .pk__card--hot .pk__btn :global(.arrow){display:block;width:2.4rem;height:2.4rem}
  .pk__card--hot .pk__btn:hover{background:var(--light)}
  .pk__custom{margin-top:2rem;background:var(--card);border-radius:3.2rem;padding:3.5rem 4rem;display:grid;grid-template-columns:79.1rem 1fr 33.6rem;align-items:center;min-height:25rem}
  .pk__cl h3{margin-top:1.4rem}
  .pk__cl p{margin-top:1.4rem;max-width:54rem;font-size:max(2rem,15px);line-height:1.3}
  .pk__chips{display:flex;flex-wrap:wrap;gap:1.2rem;max-width:37rem}
  .pk__chips li{display:flex;align-items:center;gap:.8rem;height:4.8rem;padding:0 1.8rem 0 1.4rem;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:max(1.8rem,14px);font-weight:500;white-space:nowrap}
  .pk__chips li :global(svg){width:2rem;height:2rem;color:var(--deep)}
  .pk__chips li.on{background:var(--deep);border-color:var(--deep);color:#fff}
  .pk__chips li.on :global(svg){color:#fff}
  .pk__cr p{margin-top:.8rem;font-size:max(1.8rem,14px);color:var(--muted)}
  .pk__cbtn{margin-top:2.8rem;height:5.8rem;padding:0 2.8rem 0 3.2rem;font-size:max(1.8rem,15px)}
  .pk__note{margin-top:4rem;font-size:max(1.8rem,13px);color:var(--muted)}
  @media (max-width:1023px){
    .pk{padding:56px 12px 24px}
    .pk :global(.head){padding:0 8px 8px}
    .pk__grid{margin-top:20px;grid-template-columns:1fr;gap:12px}
    .pk__card{border-radius:20px;padding:18px;min-height:0}
    .pk__card:hover{transform:none;box-shadow:none}
    .pk__top{position:absolute;right:18px;top:20px;height:auto}
    .pk__ico{display:none}
    .pk__tag{height:28px;padding:0 12px;font-size:12px}
    .pk h3{font-size:28px;line-height:32px}
    .pk__card h3{margin-top:4px}
    .pk__sub{margin-top:10px;font-size:15px}
    .pk__inc{margin-top:14px;background:rgba(0,0,0,.05);border-radius:14px;padding:14px 16px}
    .pk__card--hot .pk__inc{background:rgba(255,255,255,.12);color:#fff}
    .pk__inc>span{display:none}
    .pk__inc ul{gap:8px}.pk__inc li{font-size:15px;gap:10px}
    .pk :global(.pk__tick){width:18px;height:18px}
    .pk__card--hot :global(.pk__tick){color:#fff}
    .pk__bottom{padding-top:14px}
    .pk__price{font-size:28px;line-height:32px}
    .pk__term{display:block;margin-top:2px;font-size:12px}
    .pk__term i{display:inline;font-style:normal}
    .pk__month{font-size:12px;font-weight:400;color:inherit!important}
    .pk__btn,.pk__card--hot .pk__btn{margin-top:14px;height:56px;font-size:16px}
    .pk__btn :global(.arrow){display:block}
    .pk__custom{margin-top:12px;border-radius:20px;padding:18px;display:flex;flex-direction:column;align-items:stretch;gap:12px;min-height:0}
    .pk__cl h3{margin-top:4px}
    .pk__cl p{margin-top:8px;font-size:14px;line-height:20px}
    .pk__chips{gap:4px 6px;max-width:none}
    .pk__chips li,.pk__chips li.on{height:30px;padding:0 12px;background:none;border:0;color:var(--ink);font-size:14px}
    .pk__chips li :global(svg){display:none}
    .pk__cr p{display:none}
    .pk__cbtn{margin-top:12px;height:56px;width:100%;font-size:16px}
    .pk__note{margin-top:14px;padding:0 8px;font-size:13px;line-height:18px}
  }
  @media (min-width:768px) and (max-width:1023px){.pk{padding:56px 20px 24px}.pk__grid{grid-template-columns:1fr 1fr}}
  @media (min-width:1024px) and (max-width:1500px){.pk__custom{grid-template-columns:1fr 1fr 34rem}}
</style>
