---
import { ticker } from '../../i18n/ru';
const items = [...ticker, ...ticker];
---
<div class="section tick" aria-hidden="true">
  <div class="tick__track">{items.map((t) => <span>{t}</span>)}</div>
</div>
<style>
  .tick{height:20rem;overflow:hidden;display:flex;align-items:center;-webkit-mask-image:linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent);mask-image:linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent)}
  .tick__track{display:flex;gap:6.2rem;white-space:nowrap;font-size:5.6rem;line-height:1;font-weight:500;letter-spacing:-.03em;color:#c9d6cd;animation:tick 40s linear infinite;padding-left:6.2rem;will-change:transform}
  @keyframes tick{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.tick__track{animation:none}}
  @media (max-width:1023px){.tick{height:64px;border-radius:20px}.tick__track{font-size:24px;gap:28px;padding-left:28px}}
</style>
