---
/**
 * Мета-теги SEO: title, description, canonical, Open Graph, Twitter.
 * Подключается из Base.astro, пропсы — с каждой страницы.
 */
interface Props {
  title: string;
  description: string;
  url?: string;
  image?: string;
  /** Служебные страницы (styleguide) — не индексировать */
  noindex?: boolean;
}

const {
  title,
  description,
  url = 'https://southwood.pw',
  image = 'https://southwood.pw/og-cover.png',
  noindex = false,
} = Astro.props;

const robots = noindex ? 'noindex, nofollow' : 'index, follow';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Сергей Воробьев: сайты, CRM, боты и автоматизация для бизнеса и учреждений" />
<meta property="og:site_name" content="Сергей Воробьев" />
<meta property="og:locale" content="ru_RU" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="author" content="Сергей Воробьев" />
<meta name="robots" content={robots} />
