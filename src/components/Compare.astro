---
import { content } from '../data/content.js';
import CompareBoard from './CompareBoard';
import Reveal from './Reveal.astro';
import './Compare.css';

const { num, h2, note } = content.compare;
---

<section class="section compare" id="compare" aria-labelledby="compare-title">
  <div class="container">
    <Reveal>
      <header class="compare__intro">
        <p class="label compare__num">{num}</p>
        <h2 id="compare-title">{h2}</h2>
      </header>
    </Reveal>

    <Reveal>
      <CompareBoard client:visible />
    </Reveal>

    <Reveal>
      <p class="compare__note">{note}</p>
    </Reveal>
  </div>
</section>
