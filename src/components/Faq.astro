---
import { content } from '../data/content.js';
import FaqList from './FaqList';
import Reveal from './Reveal.astro';
import './Faq.css';

const { num, h2 } = content.faq;
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__layout">
    <Reveal>
      <header class="faq__intro">
        <p class="label faq__num">{num}</p>
        <h2 id="faq-title">{h2}</h2>
      </header>
    </Reveal>

    <Reveal>
      <FaqList client:visible />
    </Reveal>
  </div>
</section>
