---
import { content } from '../data/content.js';
import Reveal from './Reveal.astro';
import './Recognition.css';

const { num, h2, items, closing } = content.recognition;
---

<section
  class="section recognition"
  id="recognition"
  aria-labelledby="recognition-title"
>
  <div class="container">
    <Reveal>
      <header class="recognition__intro">
        <p class="label recognition__num">{num}</p>
        <h2 id="recognition-title">{h2}</h2>
      </header>
    </Reveal>

    <ul class="recognition__grid">
      {
        items.map((item, i) => (
          <Reveal as="li" className="recognition-card">
            <span class="label recognition-card__n">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="recognition-card__title">{item.title}</h3>
            <p class="recognition-card__text">{item.text}</p>
          </Reveal>
        ))
      }
    </ul>

    <Reveal>
      <p class="recognition__closing">{closing}</p>
    </Reveal>
  </div>
</section>
