---
/**
 * Появление при скролле: fade + сдвиг, один раз.
 * Замена motion whileInView — CSS .reveal + IntersectionObserver.
 */
interface Props {
  className?: string;
  /** Тег-обертка: для списков — li */
  as?: 'div' | 'li';
}

const { className = '', as: Tag = 'div' } = Astro.props;
---

<Tag class:list={['reveal', className]}>
  <slot />
</Tag>

<script>
  function initReveals() {
    const nodes = [
      ...document.querySelectorAll('.reveal:not([data-reveal-ready])'),
    ];
    if (nodes.length === 0) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      nodes.forEach((el) => {
        el.classList.add('is-visible');
        el.dataset.revealReady = '1';
      });
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    nodes.forEach((el) => {
      el.dataset.revealReady = '1';
      io.observe(el);
    });
  }

  requestAnimationFrame(() => initReveals());
  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(() => initReveals());
  });
</script>
