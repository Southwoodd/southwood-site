---
/**
 * Знак Замыкание — inline SVG из public/logo-mark*.svg.
 * variant: on-yellow — зеленый знак для светлого фона (имя осталось от старой шапки);
 *          signal — белый знак для темного фона.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  variant?: 'on-yellow' | 'signal';
  class?: string;
  /** Множитель размера: 1 = 24×24, 2 = 48×48 */
  scale?: 1 | 2;
}

const { variant = 'signal', class: className = '', scale = 1 } = Astro.props;

const file = variant === 'on-yellow' ? 'logo-mark.svg' : 'logo-mark-white.svg';

const raw = readFileSync(resolve('public', file), 'utf-8');
const svg = raw.replace(
  '<svg ',
  '<svg class="brand-mark__svg" aria-hidden="true" focusable="false" ',
);

const w = 24 * scale;
const h = 24 * scale;
---

<span
  class:list={['brand-mark', className]}
  style={`--brand-w:${w}px;--brand-h:${h}px`}
  set:html={svg}
/>

<style>
  .brand-mark {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
  }

  .brand-mark :global(.brand-mark__svg) {
    display: block;
    width: var(--brand-w);
    height: var(--brand-h);
  }
</style>
