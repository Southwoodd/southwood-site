---
import '../styles/site.css';
import '../styles/illus.css';
import CookieBar from '../components/site/CookieBar.astro';
import Modals from '../components/site/Modals.astro';
interface Props { title: string; description: string; lang?: string; noindex?: boolean; path?: string; image?: string }
const { title, description, lang = 'ru', noindex = false, path = '/', image = '/og-cover.png' } = Astro.props;
// Описание для выдачи: целые предложения, пока укладываемся в 160 знаков
const clip = (t: string) => {
  if (t.length <= 160) return t;
  const parts = t.match(/[^.!?]+[.!?]+/g) || [t]; let out = '';
  for (const x of parts) { if ((out + x).trim().length > 160) break; out += x; }
  out = out.trim();
  return out.length >= 110 ? out : t.slice(0, 157).replace(/\s+\S*$/, '') + '…';
};
const desc = clip(description);
const url = new URL(path, Astro.site).toString();
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f3f6f2" />
    <meta name="yandex-verification" content="503f0a2314eaa74b" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/onest-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Сергей Воробьев" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only" href="#main">К содержимому</a>
    <slot />
    <Modals />
    <CookieBar />
    <script>
      // Появление блоков при скролле
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Иллюстрации: запуск при появлении, пауза вне экрана
      const il = new IntersectionObserver((entries) => {
        for (const e of entries) { e.target.classList.toggle('is-on', e.isIntersecting); if (e.isIntersecting) e.target.classList.add('is-in'); }
      }, { threshold: 0.3 });
      document.querySelectorAll('.il').forEach((el) => il.observe(el));

      // Аккордеоны: на телефоне свернуты, на десктопе раскрыты всегда
      const mqFold = matchMedia('(max-width: 1023px)');
      const syncFold = () => document.querySelectorAll<HTMLDetailsElement>('details.fold').forEach((d) => { d.open = !mqFold.matches || d.hasAttribute('data-open-m'); });
      syncFold(); mqFold.addEventListener('change', syncFold);
      document.querySelectorAll<HTMLDetailsElement>('details[data-group]').forEach((d) => d.addEventListener('toggle', () => {
        if (!d.open || !mqFold.matches) return;
        document.querySelectorAll<HTMLDetailsElement>(`details[data-group="${d.dataset.group}"]`).forEach((o) => { if (o !== d) o.open = false; });
      }));

      // Счетчики
      const nf = new Intl.NumberFormat('ru-RU');
      const co = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement; co.unobserve(el);
          const to = Number(el.dataset.count); const t0 = performance.now(); const dur = 1400;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.textContent = nf.format(to); continue; }
          const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur); const v = Math.round(to * (1 - Math.pow(1 - p, 3))); el.textContent = nf.format(v); if (p < 1) requestAnimationFrame(tick); };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => co.observe(el));

      // Кнопки с набором или режимом калькулятора: передаем команду, в том числе через переход на страницу цен
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('a[data-pack], a[data-go], button[data-go]');
        if (!el) return;
        const detail = { pack: el.dataset.pack, go: el.dataset.go };
        try { sessionStorage.setItem('pricingGo', JSON.stringify(detail)); } catch {}
        (window as any).__pricingGo = detail; // остров заберет команду, если еще не загрузился
        window.dispatchEvent(new CustomEvent('pricing:go', { detail }));
      });
      // Цели Метрики: клик по элементу с data-goal и дочитывание статьи
      document.addEventListener('click', (e) => {
        const g = (e.target as HTMLElement).closest<HTMLElement>('[data-goal]');
        if (g) (window as any).swGoal?.(g.dataset.goal);
      });
      const endMark = document.querySelector('[data-read-end]');
      if (endMark) {
        const t0 = Date.now();
        const ro = new IntersectionObserver((en) => {
          if (!en[0].isIntersecting || Date.now() - t0 < 30000) return; // долистал до конца и провел на странице не меньше 30 секунд
          (window as any).swGoal?.('article_read'); window.dispatchEvent(new CustomEvent('article:read')); ro.disconnect();
        });
        ro.observe(endMark);
      }
      // Плавный скролл только на десктопе с мышью
      const desktop = matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)').matches;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Якорные ссылки: если страница по пути подросла и прокрутка не доехала, доводим до места
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]'); if (!a) return;
        const u = new URL(a.href, location.href); if (u.pathname !== location.pathname || u.hash.length < 2) return;
        const el = document.getElementById(decodeURIComponent(u.hash.slice(1))); if (!el) return;
        let live = true; const stop = () => { live = false; };
        ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach((n) => addEventListener(n, stop, { once: true, passive: true }));
        const fix = () => {
          if (!live) return;
          const off = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          const d = el.getBoundingClientRect().top - off; if (Math.abs(d) < 6) return;
          const L = (window as any).__lenis;
          if (L) L.scrollTo(scrollY + d, { duration: 0.5 }); else scrollTo({ top: scrollY + d, behavior: 'smooth' });
        };
        setTimeout(fix, 1150); setTimeout(fix, 1900);
      });
      if (desktop && !calm) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({ duration: 0.9, smoothWheel: true, anchors: { offset: -30 } });
          (window as any).__lenis = lenis;
          const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
          requestAnimationFrame(raf);
        });
      }
    </script>
  </body>
</html>
