---
/**
 * Базовый каркас для заглушки (редизайн).
 */
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  url?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const url =
  Astro.props.url ??
  new URL(Astro.url.pathname, Astro.site ?? 'https://southwood.pw').href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3f6f2" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      url={url}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: #f3f6f2;
  }

  body {
    -webkit-font-smoothing: antialiased;
  }
</style>
