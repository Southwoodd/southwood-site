---
// Страница услуги. Один шаблон на все: цены и допы берутся из каталога калькулятора.
import Page from '../../layouts/Page.astro';
import Crumbs from '../../components/site/Crumbs.astro';
import Head from '../../components/ui/Head.astro';
import Arrow from '../../components/site/Arrow.astro';
import Process from '../../components/site/Process.astro';
import Cases from '../../components/site/Cases.astro';
import { nb, automation, readTime } from '../../i18n/ru';
import { SERVICES, serviceHref, addonLabel, caseBy, R_, type Service } from '../../i18n/routes';
import { LIVE_POSTS } from '../../i18n/blog';
import { industryBy, industryHref } from '../../i18n/industries';
export function getStaticPaths() { return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props as { s: Service };
const path = serviceHref(s.slug);
const crumbs = [{ label: 'Услуги', href: R_.services }, { label: s.menu }];
const first = caseBy[s.cases[0]];
const scn = (s.scenarios || []).map((k) => (automation.scenarios.list as any[]).find((x) => x.key === k)).filter(Boolean);
const others = SERVICES.filter((x) => x.slug !== s.slug);
const relPosts = (s.related?.posts || []).map((k) => LIVE_POSTS.find((p) => p.slug === k)).filter(Boolean);
const relInd = (s.related?.industries || []).map((k) => industryBy[k]).filter(Boolean);
const ld = [
  { '@type': 'Service', '@id': `https://southwood.pw${path}#service`, name: s.h1.join(' '), description: s.lead, url: `https://southwood.pw${path}`, serviceType: s.menu, areaServed: { '@type': 'Country', name: 'Россия' }, provider: { '@id': 'https://southwood.pw/#person' },
    offers: { '@type': 'AggregateOffer', priceCurrency: 'RUB', lowPrice: s.from * 1000, offerCount: s.kinds.length } },
  { '@type': 'FAQPage', mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
import AutoFlow from '../../components/site/AutoFlow.astro';
---
<Page title={s.seoTitle} description={s.seoDesc} path={path} label={s.menu} crumbs={crumbs} ld={ld}>
  <section class="section ph ph--svc">
    <div class="ph__left">
      <Crumbs items={crumbs} />
      <h1>{s.h1.map((l) => <span>{nb(l)} </span>)}</h1>
      <p class="ph__lead">{nb(s.lead)}</p>
      <ul class="ph__chips"><li>от {s.from} тыс. ₽{s.fromUnit ? ` ${s.fromUnit}` : ''}</li>{s.chips.map((c) => <li>{c}</li>)}</ul>
      <div class="ph__cta">
        <a class="btn btn--deep" href={R_.calc} data-go="calc" data-goal="service_calc">Рассчитать стоимость<Arrow /></a>
        <button class="btn btn--grey" type="button" data-open={s.slug === 'obuchenie-ai' ? 'study' : 'lead'} data-chips={s.chipsForm} data-context={`service:${s.slug}`}>{s.slug === 'obuchenie-ai' ? 'Оставить заявку' : 'Бесплатная консультация'}<Arrow /></button>
      </div>
    </div>
    {first.noimg ? (
      <div class="ph__vis ph__vis--plain"><p>{nb(first.summary)}</p></div>
    ) : (
      <div class="ph__vis">
        <a href={first.href} aria-label={`Кейс: ${first.name}`}>
          <img src={`/img/cases/${first.key}.webp`} alt={`${first.name}: экраны проекта`} loading="eager" decoding="async" />
          <b>{first.name}</b>
          <p>{nb(first.lead)}</p>
          <small>{first.term}</small>
        </a>
      </div>
    )}
  </section>

  {s.slug === 'avtomatizaciya' && <AutoFlow />}

  {s.points && (
    <section class="section sec pts">
      <Head badge={s.points.badge} icon="task" intro={s.points.intro} title={s.points.title} />
      <ul class="pts__grid">
        {s.points.list.map((x, i) => (
          <li data-reveal style={`--d:${(i % 3) * 70}ms`}><h3>{nb(x.title)}</h3><p>{nb(x.text)}</p></li>
        ))}
      </ul>
    </section>
  )}

  <section class="section sec" id="prices">
    <Head badge="Prices" icon="shield" intro={s.kindsIntro} title={s.kindsTitle} />
    <ul class:list={['kinds', { 'kinds--4': s.kinds.length === 4 }]}>
      {s.kinds.map((k, i) => (
        <li class:list={{ hot: k.hot }} data-reveal style={`--d:${i * 80}ms`}>
          <h3>{k.title}</h3>
          <b>{nb(k.price)}</b>
          <p>{nb(k.text)}</p>
          {k.note && <small>{k.note}</small>}
        </li>
      ))}
    </ul>
    <h3 class="sec__h3">Можно добавить</h3>
    <ul class="pills">{s.addons.map((a) => <li>{addonLabel(a)}</li>)}{(s.extra || []).map((e) => <li>{e}</li>)}</ul>
    <p class="sec__calc"><a class="btn btn--ink" href={R_.calc} data-go="calc">Собрать в калькуляторе<Arrow /></a><span>{nb(s.calcNote || 'Цены для компании до 50 человек. Точную сумму фиксирую в договоре после брифа на 30–45 минут.')}</span></p>
  </section>

  {s.videos && (
    <section class="section sec vids" id="raboty">
      <Head badge="Works" icon="flash" intro="Ролики смонтированы из материала, который сняли сами заказчики. Нажмите, чтобы посмотреть со звуком." title={['Примеры работ']} />
      <ul class="vids__grid">
        {s.videos.map((v, i) => (
          <li class:list={{ 'vids--wide': v.wide }} data-reveal style={`--d:${(i % 3) * 70}ms`}>
            <button type="button" class="vids__play" data-vid aria-label={`Смотреть ролик ${v.title}`}>
              <video src={`/video/${v.file}.mp4`} poster={`/video/poster/${v.file}.webp`} preload="none" playsinline loop muted></video>
              <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></i>
              <span class="vids__dur">{v.dur}</span>
            </button>
            <h3>{v.title}</h3>
            <p>{nb(v.note)}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {s.mult && (
    <section class="section sec sec--deep">
      <Head badge={s.mult.badge} icon="task" intro={s.mult.intro} title={[s.mult.title]} />
      <ul class="mult">{s.mult.list.map((m, i) => <li class:list={{ hot: m.hot }} data-reveal style={`--d:${i * 60}ms`}><h3>{m.title}</h3><b>{m.k}</b><p>{nb(m.text)}</p></li>)}</ul>
    </section>
  )}

  {scn.length > 0 && (
    <section class="section sec">
      <Head badge="Scenarios" icon="flash" intro={automation.scenarios.note} title={['Типовые сценарии']} />
      <ul class="scn">
        {scn.map((x: any) => (
          <li data-reveal>
            <span>{x.who} · {x.apps.join(' → ')}</span>
            <h3>{x.title}</h3>
            <dl><div><dt>{automation.scenarios.was}</dt><dd>{nb(x.was)}</dd></div><div><dt>{automation.scenarios.now}</dt><dd>{nb(x.now)}</dd></div></dl>
            <em><span>{x.price}</span><span>·</span><span>{x.term}</span><span>·</span><span>{x.cond}</span></em>
          </li>
        ))}
      </ul>
    </section>
  )}

  <Process />
  <Cases keys={s.cases} title={[s.casesTitle]} intro="Работы, которые можно открыть и проверить. У каждой своя страница с задачей, решением и сроком." />

  <section class="section sec sec--mint" id="faq">
    <Head badge="FAQ" icon="shield" intro={`Вопросы именно про эту услугу. Общие вопросы о сроках, гарантии и доступах собраны на странице Обо мне.`} title={['Частые вопросы']} />
    <div class="qa">{s.faq.map((f, i) => <details name="svc-faq" open={i === 0}><summary><h3>{nb(f.q)}</h3><i></i></summary><p>{nb(f.a)}</p></details>)}</div>
  </section>

  {(relPosts.length > 0 || relInd.length > 0) && (
    <section class="section sec rel">
      {relPosts.length > 0 && (
        <>
          <h2>Разборы по теме</h2>
          <ul>{relPosts.map((p: any) => <li><a href={`/blog/${p.slug}/`}><span>{nb(p.title)}</span><small>{readTime(p.minutes)}</small><Arrow /></a></li>)}</ul>
        </>
      )}
      {relInd.length > 0 && (
        <>
          <h2 class="rel__second">Решения под отрасль</h2>
          <ul>{relInd.map((n: any) => <li><a href={industryHref(n.slug)}><span>{n.menu}</span><small>от {n.from} тыс. ₽</small><Arrow /></a></li>)}</ul>
        </>
      )}
    </section>
  )}

  <section class="section sec oth">
    <h2>Другие услуги</h2>
    <ul>{others.map((o) => <li><a href={serviceHref(o.slug)}><span>{o.menu}</span><small>от {o.from} тыс. ₽</small><Arrow /></a></li>)}</ul>
  </section>
</Page>
<style>
  .rel{padding-top:5.6rem;padding-bottom:5.6rem}
  .rel h2{font-size:2.4rem;font-weight:500;letter-spacing:-.02em}
  .rel__second{margin-top:4.8rem}
  .rel ul{margin-top:2.4rem;display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem}
  .rel a{min-height:7.2rem;padding:1.6rem 2.4rem;border-radius:2rem;background:var(--card);display:flex;align-items:center;gap:1.6rem;font-size:max(1.7rem,14px);font-weight:500;line-height:1.3;transition:background-color .2s var(--ease)}
  .rel a:hover{background:var(--mint)}
  .rel small{margin-left:auto;font-size:max(1.5rem,13px);font-weight:400;color:var(--muted);white-space:nowrap}
  .rel :global(.arrow){width:1.8rem;height:1.8rem;flex:none}
  .oth{padding-top:5.6rem;padding-bottom:5.6rem}
  .oth h2{font-size:2.4rem;font-weight:500;letter-spacing:-.02em}
  .oth ul{margin-top:2.4rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
  .oth a{height:7.2rem;padding:0 2.4rem;border-radius:2rem;background:var(--card);display:flex;align-items:center;gap:1.6rem;font-size:max(1.8rem,15px);font-weight:500;transition:background-color .2s var(--ease)}
  .oth a:hover{background:var(--mint)}
  .oth small{margin-left:auto;font-size:max(1.5rem,13px);font-weight:400;color:var(--muted);white-space:nowrap}
  .oth :global(.arrow){width:1.8rem;height:1.8rem;flex:none}
  /* телефон: вместо rem берем нижнюю границу в px */
  @media (max-width:1023px){.oth a{font-size:15px}.oth small{font-size:13px}.rel a{font-size:14px}.rel small{font-size:13px}.rel h2{font-size:20px}}
  @media (max-width:1023px){.oth ul{grid-template-columns:1fr;gap:8px;margin-top:14px}.oth a{height:56px;padding:0 16px;border-radius:16px}.oth h2{font-size:20px}.rel ul{grid-template-columns:1fr;gap:8px;margin-top:14px}.rel a{padding:14px 16px;border-radius:16px}.rel__second{margin-top:28px}.rel{padding-top:32px;padding-bottom:32px}}
  .vids__grid{margin-top:5.6rem;display:grid;grid-template-columns:repeat(3,1fr);gap:2.4rem}
  .pts__grid{margin-top:5.6rem;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  .pts__grid li{background:var(--card);border-radius:2.4rem;padding:3.2rem}
  .pts__grid h3{font-size:max(2.2rem,16px);line-height:1.2;font-weight:500;letter-spacing:-.02em}
  .pts__grid p{margin-top:1.6rem;font-size:max(1.7rem,14px);line-height:1.45;color:var(--muted)}
  @media (max-width:1023px){.pts__grid{grid-template-columns:1fr;gap:8px;margin-top:24px}.pts__grid li{border-radius:16px;padding:18px}.pts__grid h3{font-size:16px}.pts__grid p{margin-top:8px;font-size:14px}}
  .vids--wide .vids__play{aspect-ratio:16/9}
  .vids--wide{grid-column:1/-1}
  .vids__play{position:relative;display:block;width:100%;aspect-ratio:9/16;border-radius:2rem;overflow:hidden;background:#0d0f0e;cursor:pointer;border:0;padding:0}
  .vids__play video{width:100%;height:100%;object-fit:cover;display:block}
  .vids__play i{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:6.4rem;height:6.4rem;border-radius:50%;background:rgba(255,255,255,.92);color:var(--ink);display:grid;place-items:center;transition:transform .2s var(--ease),background-color .2s var(--ease)}
  .vids__play i svg{width:2.8rem;height:2.8rem;margin-left:.2rem}
  .vids__play:hover i{transform:translate(-50%,-50%) scale(1.06);background:#fff}
  .vids__play.is-on i{opacity:0;pointer-events:none}
  .vids__dur{position:absolute;right:1.2rem;top:1.2rem;padding:.4rem 1rem;border-radius:1rem;background:rgba(10,14,12,.6);backdrop-filter:blur(.6rem);color:#fff;font-size:max(1.4rem,12px);font-weight:500}
  .vids__play.is-on .vids__dur{opacity:0}
  .vids h3{margin-top:1.8rem;font-size:max(2rem,16px);font-weight:500;letter-spacing:-.02em}
  .vids p{margin-top:.6rem;font-size:max(1.6rem,13px);line-height:1.4;color:var(--muted)}
  @media (max-width:1023px){.vids__grid{grid-template-columns:repeat(2,1fr);gap:12px;margin-top:24px}.vids__play{border-radius:14px}.vids__play i{width:44px;height:44px}.vids__play i svg{width:20px;height:20px}.vids h3{margin-top:10px;font-size:16px}.vids p{font-size:13px;margin-top:2px}}
</style>
<script>
  // Ролики на странице монтажа: грузим только по клику, звук включаем вместе с показом
  document.querySelectorAll<HTMLButtonElement>('[data-vid]').forEach((btn) => {
    const v = btn.querySelector('video');
    if (!v) return;
    btn.addEventListener('pointerenter', () => { if (v.preload === 'none') v.preload = 'metadata'; }, { once: true });
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-vid] video').forEach((o) => { if (o !== v) { (o as HTMLVideoElement).pause(); (o as HTMLVideoElement).controls = false; o.parentElement?.classList.remove('is-on'); } });
      if (v.paused) { v.muted = false; v.controls = true; btn.classList.add('is-on'); v.play().catch(() => { v.muted = true; v.play().catch(() => {}); }); }
      else { v.pause(); v.controls = false; btn.classList.remove('is-on'); }
    });
  });
</script>
