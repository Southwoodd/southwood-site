---
import Site from '../layouts/Site.astro';
import Header from '../components/site/Header.astro';
import Dock from '../components/site/Dock.astro';
import Footer from '../components/site/Footer.astro';
import Arrow from '../components/site/Arrow.astro';
import { pages } from '../i18n/ru';
const n = pages.notFound;
---
<Site title={n.seo} description={n.text} path="/404" noindex>
  <div class="page" id="top">
    <Header />
    <main id="main" class="section nf">
      <p class="nf__code" aria-hidden="true">{n.code}</p>
      <h1>{n.title}</h1>
      <p class="nf__text">{n.text}</p>
      <div class="nf__actions">
        <a class="btn btn--white" href="/">{n.home}<Arrow /></a>
        <a class="btn nf__ghost" href="/ceny/#pricing">{n.calc}<Arrow /></a>
        <button class="btn nf__ghost" type="button" data-open="write">{n.write}<Arrow /></button>
      </div>
    </main>
    <Footer />
  </div>
  <Dock label="Страница не найдена" />
</Site>
<style>
  .nf{background:var(--deep);color:#fff;padding:14rem 4rem 14rem;display:flex;flex-direction:column;align-items:center;text-align:center}
  .nf__code{font-size:22rem;line-height:.9;font-weight:500;letter-spacing:-.04em;color:var(--light)}
  .nf h1{margin-top:6rem;font-size:6.4rem;line-height:1.1;font-weight:500;letter-spacing:-.035em}
  .nf__text{margin-top:2.8rem;max-width:104rem;font-size:max(2.2rem,16px);color:rgba(255,255,255,.8)}
  .nf__actions{margin-top:3.6rem;display:flex;flex-wrap:wrap;justify-content:center;gap:1rem}
  .nf .btn{height:5.6rem;padding:0 2.4rem 0 2.8rem;font-size:max(1.6rem,15px)}
  .nf__ghost{border:1px solid rgba(255,255,255,.4);color:#fff}.nf__ghost:hover{background:rgba(255,255,255,.1)}
  @media (max-width:1023px){
    .nf{padding:64px 20px}
    .nf__code{font-size:120px}
    .nf h1{margin-top:24px;font-size:30px}
    .nf__text{margin-top:14px;font-size:16px;line-height:23px}
    .nf__actions{margin-top:24px;flex-direction:column;width:100%;max-width:420px}
    .nf .btn{height:56px;font-size:16px}
  }
</style>
