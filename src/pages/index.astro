---
import Page from '../layouts/Page.astro';
import Promo from '../components/site/Promo.astro';
import Hero from '../components/site/Hero.astro';
import Ticker from '../components/site/Ticker.astro';
import Clients from '../components/site/Clients.astro';
import Proofs from '../components/site/Proofs.astro';
import ServiceTiles from '../components/site/ServiceTiles.astro';
import Cases from '../components/site/Cases.astro';
import Packages from '../components/site/Packages.astro';
import Why from '../components/site/Why.astro';
import { ITEMS } from '../pricing/model';
import { CASES, OLD_ANCHORS } from '../i18n/routes';
---
<Page title="Разработка сайтов, CRM и ботов под ключ | Сергей Воробьев" description="Разработка сайтов и интернет-магазинов, внедрение Битрикс24, чат-боты, автоматизация и приложения под ключ. Один исполнитель вместо агентства: фиксированная смета, цены и кейсы на сайте." path="/" label="Главная">
  <Fragment slot="head">
    <!-- Старые ссылки одностраничника: якорь ведет на новую страницу, сохраненный расчет на страницу цен -->
    <script is:inline define:vars={{ map: OLD_ANCHORS }}>
      (function () { var h = location.hash.slice(1); if (!h) return; var id = h.split(/[?&]/)[0]; var to = map[id]; if (!to) return; location.replace(id === 'pricing' ? '/ceny/' + location.hash : to); })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebSite', '@id': 'https://southwood.pw/#website', url: 'https://southwood.pw/', name: 'Сергей Воробьев', alternateName: ['Southwood', 'southwood.pw'], inLanguage: 'ru-RU', publisher: { '@id': 'https://southwood.pw/#person' } },
  { '@type': 'Person', '@id': 'https://southwood.pw/#person', name: 'Сергей Воробьев', alternateName: 'Sergey Southwood', url: 'https://southwood.pw/', image: 'https://southwood.pw/icon-512.png', jobTitle: 'Разработка сайтов, CRM, ботов и автоматизация для бизнеса', email: 'im@southwood.pw', sameAs: ['https://t.me/imsouthwood', 'https://www.behance.net/imsouthwood', 'https://tenchat.ru/imsouthwood', 'https://vk.com/imsouthwood'] },
  { '@type': 'ProfessionalService', '@id': 'https://southwood.pw/#service', name: 'Сергей Воробьев: разработка сайтов, CRM и ботов', url: 'https://southwood.pw/', image: 'https://southwood.pw/og-cover.png', logo: 'https://southwood.pw/icon-512.png', founder: { '@id': 'https://southwood.pw/#person' }, address: { '@type': 'PostalAddress', addressLocality: 'Краснодар', addressCountry: 'RU' }, areaServed: { '@type': 'Country', name: 'Россия' }, knowsAbout: ['Разработка сайтов', 'Интернет-магазины', 'Tilda', '1С-Битрикс', 'Битрикс24', 'amoCRM', 'Чат-боты Telegram, VK, MAX', 'AI-боты', 'Автоматизация бизнес-процессов', 'Интеграция с 1С', 'UX/UI-дизайн', 'SEO и GEO'], email: 'im@southwood.pw',
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Услуги и цены', itemListElement: ITEMS.filter((i) => !i.tbd && i.base[1] > 0).map((i) => ({ '@type': 'Offer', priceCurrency: 'RUB', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'RUB', minPrice: i.base[0] * 1000, maxPrice: i.base[1] * 1000 }, itemOffered: { '@type': 'Service', name: i.name, description: i.desc } })) } },
  { '@type': 'ItemList', '@id': 'https://southwood.pw/kejsy/#list', name: 'Выполненные проекты', itemListElement: CASES.map((c, n) => ({ '@type': 'ListItem', position: n + 1, url: 'https://southwood.pw' + c.href, name: c.name })) },
] })} />
  </Fragment>
  <Promo />
  <Hero />
  <Ticker />
  <Clients />
  <Proofs />
  <ServiceTiles />
  <Cases keys={['alfa', 'meetflow', 'mono', 'caro']} />
  <Packages />
  <Why />
</Page>
