---
/**
 * Библиотека компонентов Southwood — живой каталог токенов и блоков.
 * Служебная: noindex, не в sitemap. URL: /ui
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Recognition from '../components/Recognition.astro';
import Zones from '../components/Zones.astro';
import Cases from '../components/Cases.astro';
import Pricing from '../components/Pricing.astro';
import Compare from '../components/Compare.astro';
import About from '../components/About.astro';
import Boundaries from '../components/Boundaries.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import LeadRoot from '../components/LeadRoot';
import ScrambleButton from '../components/ScrambleButton';
import ScrambleLink from '../components/ScrambleLink';
import OpenLeadCta from '../components/OpenLeadCta';
import '../styles/ui-library.css';

const colors = [
  { name: '--bg', value: '#070707', note: 'фон страницы' },
  { name: '--bg-elevated', value: '#0e0e0e', note: 'приподнятый фон' },
  { name: '--surface', value: '#0a0a0a', note: 'поверхности' },
  { name: '--panel-solid', value: '#0c0c0a', note: 'панель / модалка' },
  { name: '--ink', value: '#eaff00', note: 'основной текст' },
  { name: '--ink-soft', value: 'rgba(234, 255, 0, 0.78)', note: 'вторичный текст' },
  { name: '--ink-dim', value: 'rgba(234, 255, 0, 0.48)', note: 'приглушённый' },
  { name: '--line', value: 'rgba(234, 255, 0, 0.2)', note: 'тонкие линии' },
  { name: '--line-strong', value: 'rgba(234, 255, 0, 0.4)', note: 'акцент-бордер' },
  { name: '--accent / --signal', value: '#eaff00', note: 'signal yellow' },
  { name: '--on-accent', value: '#070707', note: 'текст на жёлтом' },
  { name: 'hover primary', value: '#f5ff66', note: 'только в .btn--primary:hover' },
];

const nav = [
  { href: '#lib-colors', label: 'Цвета' },
  { href: '#lib-type', label: 'Типографика' },
  { href: '#lib-primitives', label: 'Примитивы' },
  { href: '#lib-islands', label: 'Острова' },
  { href: '#lib-sections', label: 'Секции' },
  { href: '#lib-meta', label: 'Служебные' },
];

const sections = [
  { id: 'Hero', file: 'Hero.astro' },
  { id: 'Recognition', file: 'Recognition.astro' },
  { id: 'Zones', file: 'Zones.astro' },
  { id: 'Cases', file: 'Cases.astro' },
  { id: 'Pricing', file: 'Pricing.astro' },
  { id: 'Compare', file: 'Compare.astro' },
  { id: 'About', file: 'About.astro' },
  { id: 'Boundaries', file: 'Boundaries.astro' },
  { id: 'Faq', file: 'Faq.astro' },
  { id: 'FinalCta', file: 'FinalCta.astro' },
  { id: 'Header', file: 'Header.astro' },
  { id: 'Footer', file: 'Footer.astro' },
];

const metaComponents = [
  { name: 'Seo.astro', role: 'title, description, OG, Twitter, robots' },
  { name: 'JsonLd.astro', role: 'Person + ProfessionalService + WebSite (только главная)' },
  { name: 'Reveal.astro', role: 'появление секций (IntersectionObserver)' },
  { name: 'LeadRoot.tsx', role: 'HUD-курсор + провайдер модалки' },
  { name: 'LeadModal.tsx', role: 'модалка заявки' },
  { name: 'LeadForm.tsx', role: 'форма → Web3Forms' },
  { name: 'LeadModalContext.tsx', role: 'открытие модалки + intent (тариф/тема)' },
  { name: 'CasePage.astro', role: 'шаблон кейса /cases/[slug]' },
  { name: 'CaseLink.tsx', role: 'ссылка на кейс со scramble' },
  { name: 'FaqList.tsx', role: 'аккордеон FAQ' },
  { name: 'CompareBoard.tsx', role: 'таблица сравнения' },
  { name: 'HudPointer.tsx', role: 'параллакс сетки под курсором' },
  { name: 'ScramblePress.tsx', role: 'ядро scramble-эффекта' },
];
---

<Base
  title="UI Library — Southwood"
  description="Живая библиотека токенов и компонентов Southwood. Служебная страница."
  noindex={true}
>
  <LeadRoot client:load />

  <div class="lib">
    <aside class="lib-nav" aria-label="Разделы библиотеки">
      <a class="lib-nav__brand" href="/">
        <img
          class="lib-nav__mark"
          src="/logo-pixel.svg"
          alt=""
          width="72"
          height="18"
          decoding="async"
        />
        <span>← southwood.pw</span>
      </a>
      <p class="label lib-nav__title">UI Library</p>
      <ul class="lib-nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="lib-main">
      <header class="lib-hero container">
        <p class="label">Southwood · Design system</p>
        <h1>Библиотека компонентов</h1>
        <p class="lead">
          Все токены и блоки сайта в одном месте. Палитра HUD: чёрный
          <code>#070707</code> + signal yellow <code>#eaff00</code>. Шрифты:
          Oxanium + IBM Plex Mono.
        </p>
      </header>

      <!-- Цвета -->
      <section class="lib-block container" id="lib-colors">
        <h2 class="lib-block__h">Цвета</h2>
        <p class="lib-block__sub">Источник: <code>src/styles/tokens.css</code></p>
        <div class="lib-swatches">
          {
            colors.map((c) => (
              <article class="lib-swatch">
                <div
                  class="lib-swatch__chip"
                  style={`background:${c.value}`}
                  aria-hidden="true"
                />
                <div class="lib-swatch__meta">
                  <code>{c.name}</code>
                  <span>{c.value}</span>
                  <span class="lib-swatch__note">{c.note}</span>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Типографика -->
      <section class="lib-block container" id="lib-type">
        <h2 class="lib-block__h">Типографика</h2>
        <div class="lib-type">
          <div>
            <p class="label">H1 · Oxanium</p>
            <h1>Цифровая инфраструктура</h1>
          </div>
          <div>
            <p class="label">H2 · Oxanium</p>
            <h2>Собранные системы</h2>
          </div>
          <div>
            <p class="label">H3 · Oxanium</p>
            <h3>Продуктовая архитектура</h3>
          </div>
          <div>
            <p class="label">Body</p>
            <p>
              Собираю цифровую инфраструктуру для среднего бизнеса: сайты, CRM,
              боты, AI-агенты и документы в одну систему.
            </p>
          </div>
          <div>
            <p class="label">.lead · IBM Plex Mono</p>
            <p class="lead">
              Для собственников, у которых бизнес вырос, а цифровая часть
              осталась на старте.
            </p>
          </div>
          <div>
            <p class="label">.label</p>
            <p class="label">Цифровая инфраструктура</p>
          </div>
        </div>
      </section>

      <!-- Примитивы -->
      <section class="lib-block container" id="lib-primitives">
        <h2 class="lib-block__h">Примитивы</h2>
        <p class="lib-block__sub">Классы из <code>global.css</code></p>
        <div class="lib-row">
          <a class="btn btn--primary" href="#lib-primitives">Primary</a>
          <a class="btn btn--ghost" href="#lib-primitives">Ghost</a>
          <span class="label">Label sample</span>
        </div>
        <div class="lib-panel">
          <p class="label">--panel / --panel-solid</p>
          <p class="lead">Панель как у модалки и HUD-поверхностей.</p>
        </div>
      </section>

      <!-- React-острова -->
      <section class="lib-block container" id="lib-islands">
        <h2 class="lib-block__h">Интерактивные острова</h2>
        <p class="lib-block__sub">React · scramble / CTA → модалка</p>
        <div class="lib-row">
          <ScrambleButton
            client:visible
            className="btn btn--primary"
            label="Scramble Button"
            href="#lib-islands"
          />
          <ScrambleButton
            client:visible
            className="btn btn--ghost"
            label="Ghost Scramble"
            href="#lib-islands"
          />
          <OpenLeadCta
            client:visible
            className="btn btn--primary"
            label="Open Lead CTA"
            topic="Диагностика"
          />
          <ScrambleLink client:visible href="/" label="Scramble Link → home" />
        </div>
      </section>

      <!-- Карта секций -->
      <section class="lib-block container" id="lib-sections">
        <h2 class="lib-block__h">Секции лендинга</h2>
        <p class="lib-block__sub">Живые компоненты как на главной</p>
        <ul class="lib-map">
          {
            sections.map((s) => (
              <li>
                <a href={`#demo-${s.id.toLowerCase()}`}>
                  <code>{s.file}</code>
                  <span>{s.id}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="lib-block container" id="lib-meta">
        <h2 class="lib-block__h">Служебные / внутренние</h2>
        <ul class="lib-meta-list">
          {
            metaComponents.map((c) => (
              <li>
                <code>{c.name}</code>
                <span>{c.role}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <!-- Живые демо секций -->
  <div class="lib-demos" id="lib-demos">
    <div class="lib-demo-label container" id="demo-header">
      <p class="label">Component · Header.astro</p>
    </div>
    <Header />

    <div class="lib-demo-label container" id="demo-hero">
      <p class="label">Component · Hero.astro</p>
    </div>
    <Hero />

    <div class="lib-demo-label container" id="demo-recognition">
      <p class="label">Component · Recognition.astro</p>
    </div>
    <Recognition />

    <div class="lib-demo-label container" id="demo-zones">
      <p class="label">Component · Zones.astro</p>
    </div>
    <Zones />

    <div class="lib-demo-label container" id="demo-cases">
      <p class="label">Component · Cases.astro</p>
    </div>
    <Cases />

    <div class="lib-demo-label container" id="demo-pricing">
      <p class="label">Component · Pricing.astro</p>
    </div>
    <Pricing />

    <div class="lib-demo-label container" id="demo-compare">
      <p class="label">Component · Compare.astro</p>
    </div>
    <Compare />

    <div class="lib-demo-label container" id="demo-about">
      <p class="label">Component · About.astro</p>
    </div>
    <About />

    <div class="lib-demo-label container" id="demo-boundaries">
      <p class="label">Component · Boundaries.astro</p>
    </div>
    <Boundaries />

    <div class="lib-demo-label container" id="demo-faq">
      <p class="label">Component · Faq.astro</p>
    </div>
    <Faq />

    <div class="lib-demo-label container" id="demo-finalcta">
      <p class="label">Component · FinalCta.astro</p>
    </div>
    <FinalCta />

    <div class="lib-demo-label container" id="demo-footer">
      <p class="label">Component · Footer.astro</p>
    </div>
    <Footer />
  </div>
</Base>
