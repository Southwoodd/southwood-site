---
import TextPage from '../components/site/TextPage.astro';
import { content } from '../data/content.js';
import { pages } from '../i18n/ru';
const c = content.consent;
---
<TextPage seoTitle={c.seoTitle} seoDescription={c.seoDescription} path="/consent/" crumb={pages.consent.crumb} title={c.title} lead={pages.consent.lead} updated={c.updated} other={pages.consent.other} otherHref={pages.consent.otherHref} sections={[{ paragraphs: c.paragraphs }]} />
